<!DOCTYPE html>
<html lang="<%= lang.lang_code %>" dir="<%= lang.direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentLang === 'en' ? 'Dashboard - Association Management' : (currentLang === 'fr' ? 'Tableau de Bord - Administration' : 'لوحة التحكم - إدارة الجمعية') %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            blue: '#122a4e',
                            green: '#4AB76B',
                            yellow: '#f59e0b'
                        }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/custom.css">
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; }
        @media print {
            body { background: white !important; }
            nav, footer, .admin-tab-btn, #btn-tab-card-sample, button, #specimen-member-selector { display: none !important; }
            body * { visibility: hidden; }
            #card-print-area, #card-print-area * { visibility: visible; }
            #card-print-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                display: grid !important;
                grid-template-columns: repeat(2, 1fr) !important;
                gap: 20px !important;
                padding: 20px !important;
            }
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-gray-950 text-gray-800 dark:text-gray-100 transition-colors">

    <nav class="bg-[#122a4e] text-white py-4 px-6 shadow-xl sticky top-0 z-50">
        <div class="container mx-auto flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-4">
                <a href="/index.php">
                    <img src="/image/logo_assoc.jpg" class="h-12 w-auto rounded-xl bg-white p-0.5 shadow-sm" alt="Logo">
                </a>
                <div>
                    <h1 class="text-xl md:text-2xl font-black tracking-wide"><%= currentLang === 'en' ? 'Administrative Center' : (currentLang === 'fr' ? 'Administration Centrale' : 'المركز الإداري للجمعية') %></h1>
                    <p class="text-[11px] text-blue-200">جمعية مبادرات بلا حدود - دار الشباب دروة</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <a href="/admin/export-csv" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl font-bold transition text-xs flex items-center gap-1.5 shadow">
                    📥 <span>تصدير Excel / CSV</span>
                </a>
                <a href="/admin_articles.php" class="bg-indigo-700/80 px-4 py-2 rounded-xl font-bold hover:bg-indigo-600 transition text-xs flex items-center gap-1.5">
                    📄 <span><%= currentLang === 'en' ? 'Moderate Articles' : 'مراجعة المقالات' %></span>
                    <% const pendingArticlesCount = articles.filter(a => a.status === 'en_attente').length; %>
                    <% if (pendingArticlesCount > 0) { %>
                        <span class="bg-yellow-400 text-blue-950 px-2 py-0.5 rounded-full text-[10px] font-black"><%= pendingArticlesCount %></span>
                    <% } %>
                </a>
                <a href="/index.php" class="bg-white/10 px-3 py-2 rounded-xl font-bold hover:bg-white/20 transition text-xs"><%= lang.nav_home %></a>
                <a href="/logout.php" class="bg-red-500 px-3 py-2 rounded-xl font-bold hover:bg-red-600 transition text-xs"><%= lang.logout %></a>
            </div>
        </div>
    </nav>

    <div class="container mx-auto py-10 px-6">
        
        <!-- Flash Alert -->
        <% if (locals.notice) { %>
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-4 mb-8 rounded-2xl font-bold text-center">
                ✅ <%= notice %>
            </div>
        <% } %>

        <!-- Admin Profile Header Banner -->
        <div class="bg-gradient-to-r from-[#122a4e] via-[#173763] to-[#0c1f38] text-white p-6 md:p-8 rounded-3xl shadow-xl mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 border border-blue-900/50">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-400 to-yellow-500 text-blue-950 font-black text-xl flex items-center justify-center shadow-lg">
                    IA
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2.5">
                        <h2 class="text-xl md:text-2xl font-black">
                            <%= locals.currentUser ? currentUser.nom_complet : 'إبراهيم أيت الديمان' %>
                        </h2>
                        <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 text-[11px] font-black px-3 py-0.5 rounded-full flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                            مدير النظام العام (Super Admin)
                        </span>
                        <span class="bg-orange-500/25 text-orange-200 border border-orange-400/40 text-[11px] font-black px-3 py-0.5 rounded-full flex items-center gap-1.5">
                            🔥 مصادق عبر Firebase Authentication
                        </span>
                        <span class="bg-blue-500/25 text-cyan-200 border border-cyan-400/40 text-[11px] font-black px-3 py-0.5 rounded-full flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                            ☁️ قاعدة بيانات Google Cloud Firestore (نشطة ومؤمنة)
                        </span>
                    </div>
                    <p class="text-xs text-blue-200 mt-1 flex flex-wrap items-center gap-2 font-medium">
                        <span>📧 <%= locals.currentUser ? currentUser.email : 'ibrahimaitaddimane@gmail.com' %></span>
                        <span>•</span>
                        <span>📍 دار الشباب دروة - جهة الدار البيضاء سطات</span>
                        <span>•</span>
                        <span>📅 <%= new Date().toLocaleDateString('ar-MA', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    </p>
                </div>
            </div>
            <div class="flex flex-wrap gap-2.5 items-center">
                <span class="bg-white/10 backdrop-blur-md px-3.5 py-1.5 rounded-xl text-xs font-bold text-blue-100 flex items-center gap-1.5 border border-white/10">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    النظام الإداري نشط
                </span>
                <a href="/admin/export-csv" class="bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-500 hover:to-yellow-600 text-blue-950 px-4 py-2 rounded-xl text-xs font-black transition shadow-md flex items-center gap-1.5">
                    📥 <span>تصدير السجلات الشاملة</span>
                </a>
            </div>
        </div>

        <!-- EXECUTIVE SUMMARY METRICS SECTION -->
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-10">
            
            <!-- PANEL 1: MEMBER REGISTRATIONS & FINANCIAL METRICS -->
            <div class="bg-white dark:bg-gray-900 rounded-3xl p-6 md:p-7 shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-center mb-6 pb-3 border-b border-gray-100 dark:border-gray-800">
                        <div class="flex items-center gap-2.5">
                            <span class="w-9 h-9 rounded-2xl bg-blue-50 dark:bg-blue-950/60 text-blue-900 dark:text-blue-300 flex items-center justify-center text-base font-black">👥</span>
                            <div>
                                <h3 class="font-black text-base text-blue-950 dark:text-white">مؤشرات تسجيل المنخرطين والاشتراكات</h3>
                                <p class="text-[11px] text-gray-400">تتبع طلبات الانخراط، حالة المصادقة، والتحصيل المالي</p>
                            </div>
                        </div>
                        <span class="text-xs font-black px-2.5 py-1 bg-blue-50 dark:bg-blue-950 text-blue-900 dark:text-blue-300 rounded-xl">دورة 2026</span>
                    </div>

                    <!-- 4 Mini Registration Metrics -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
                        <div class="bg-slate-50 dark:bg-gray-800/60 p-3.5 rounded-2xl border border-gray-100 dark:border-gray-700/60">
                            <p class="text-[11px] font-bold text-gray-400">إجمالي الطلبات</p>
                            <p class="text-2xl font-black text-blue-950 dark:text-white mt-0.5"><%= total_members %></p>
                            <span class="text-[10px] text-blue-600 dark:text-blue-400 font-bold">100% مسجلين</span>
                        </div>
                        <div class="bg-amber-50/70 dark:bg-amber-950/30 p-3.5 rounded-2xl border border-amber-100 dark:border-amber-900/40">
                            <p class="text-[11px] font-bold text-amber-700 dark:text-amber-400">قيد المراجعة</p>
                            <p class="text-2xl font-black text-amber-600 mt-0.5"><%= pending_count %></p>
                            <span class="text-[10px] text-amber-600 font-bold">تنتظر فحص CIN</span>
                        </div>
                        <div class="bg-emerald-50/70 dark:bg-emerald-950/30 p-3.5 rounded-2xl border border-emerald-100 dark:border-emerald-900/40">
                            <p class="text-[11px] font-bold text-emerald-700 dark:text-emerald-400">أعضاء معتمدون</p>
                            <p class="text-2xl font-black text-emerald-600 mt-0.5"><%= accepted_count %></p>
                            <span class="text-[10px] text-emerald-600 font-bold">بطاقة مفعلة ✓</span>
                        </div>
                        <div class="bg-purple-50/70 dark:bg-purple-950/30 p-3.5 rounded-2xl border border-purple-100 dark:border-purple-900/40">
                            <p class="text-[11px] font-bold text-purple-700 dark:text-purple-400">مداخيل الانخراط</p>
                            <p class="text-2xl font-black text-purple-600 mt-0.5"><%= locals.total_cotisations || (paid_count * 100) %> <span class="text-xs">درهم</span></p>
                            <span class="text-[10px] text-purple-600 font-bold"><%= locals.cotisation_rate || 0 %>% تحصيل</span>
                        </div>
                    </div>

                    <!-- Progress & Quartier Breakdown -->
                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between text-xs font-bold mb-1.5">
                                <span class="text-gray-600 dark:text-gray-300">نسبة سداد واجبات الانخراط (100 درهم/عضو)</span>
                                <span class="text-purple-600 font-black"><%= locals.paid_count || 0 %> مسدد / <%= locals.unpaid_count || 0 %> في الانتظار (<%= locals.cotisation_rate || 0 %>%)</span>
                            </div>
                            <div class="w-full h-2.5 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-purple-500 to-indigo-600 rounded-full transition-all duration-500" style="width: <%= Math.max(5, locals.cotisation_rate || 0) %>%"></div>
                            </div>
                        </div>

                        <!-- Quartiers Distribution Pills -->
                        <div class="pt-2">
                            <p class="text-[11px] font-bold text-gray-400 mb-2">التوزيع الجغرافي للمنخرطين بأحياء مدينة الدروة:</p>
                            <div class="flex flex-wrap gap-1.5">
                                <% if (locals.quartier_counts && Object.keys(quartier_counts).length > 0) { %>
                                    <% Object.entries(quartier_counts).forEach(function([quartier, count]) { %>
                                        <span class="text-[11px] font-bold bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 px-2.5 py-1 rounded-lg border border-gray-200 dark:border-gray-700 flex items-center gap-1">
                                            📍 <%= quartier %>: <strong class="text-blue-900 dark:text-yellow-400 font-black"><%= count %></strong>
                                        </span>
                                    <% }); %>
                                <% } else { %>
                                    <span class="text-xs text-gray-400">سجل الأحياء قيد التحديث</span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PANEL 2: PROJECT STATUSES & STRATEGIC ACTIVITIES METRICS -->
            <div class="bg-white dark:bg-gray-900 rounded-3xl p-6 md:p-7 shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-center mb-6 pb-3 border-b border-gray-100 dark:border-gray-800">
                        <div class="flex items-center gap-2.5">
                            <span class="w-9 h-9 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-base font-black">🎯</span>
                            <div>
                                <h3 class="font-black text-base text-blue-950 dark:text-white">مؤشرات حالة المشاريع والأنشطة الميدانية</h3>
                                <p class="text-[11px] text-gray-400">متابعة سير إنجاز الأنشطة الميدانية، الميزانيات، ونسب التقدم</p>
                            </div>
                        </div>
                        <button type="button" onclick="switchAdminTab('tab-projects')" class="text-xs font-black text-blue-600 dark:text-yellow-400 hover:underline flex items-center gap-1">
                            <span>إدارة المشاريع</span> <span>↗</span>
                        </button>
                    </div>

                    <!-- 4 Project Status Metrics -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
                        <div class="bg-slate-50 dark:bg-gray-800/60 p-3.5 rounded-2xl border border-gray-100 dark:border-gray-700/60">
                            <p class="text-[11px] font-bold text-gray-400">إجمالي المبادرات</p>
                            <p class="text-2xl font-black text-blue-950 dark:text-white mt-0.5"><%= (locals.projects || []).length %></p>
                            <span class="text-[10px] text-blue-600 dark:text-blue-400 font-bold">مشاريع معتمدة</span>
                        </div>
                        <div class="bg-blue-50/70 dark:bg-blue-950/30 p-3.5 rounded-2xl border border-blue-100 dark:border-blue-900/40">
                            <p class="text-[11px] font-bold text-blue-700 dark:text-blue-400">قيد التنفيذ</p>
                            <p class="text-2xl font-black text-blue-600 dark:text-blue-400 mt-0.5"><%= locals.active_projects_count || 0 %></p>
                            <span class="text-[10px] text-blue-600 font-bold">أنشطة جارية</span>
                        </div>
                        <div class="bg-emerald-50/70 dark:bg-emerald-950/30 p-3.5 rounded-2xl border border-emerald-100 dark:border-emerald-900/40">
                            <p class="text-[11px] font-bold text-emerald-700 dark:text-emerald-400">مشاريع منجزة</p>
                            <p class="text-2xl font-black text-emerald-600 mt-0.5"><%= locals.completed_projects_count || 0 %></p>
                            <span class="text-[10px] text-emerald-600 font-bold">محصلات نهائية ✓</span>
                        </div>
                        <div class="bg-amber-50/70 dark:bg-amber-950/30 p-3.5 rounded-2xl border border-amber-100 dark:border-amber-900/40">
                            <p class="text-[11px] font-bold text-amber-700 dark:text-amber-400">مبرمجة / للدراسة</p>
                            <p class="text-2xl font-black text-amber-600 mt-0.5"><%= (locals.planned_projects_count || 0) + (locals.study_projects_count || 0) %></p>
                            <span class="text-[10px] text-amber-600 font-bold">مشاريع مقبلة</span>
                        </div>
                    </div>

                    <!-- Progress Bar & Active Projects Preview -->
                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between text-xs font-bold mb-1.5">
                                <span class="text-gray-600 dark:text-gray-300">معدل الإنجاز والتنفيذ العام للمشاريع</span>
                                <span class="text-emerald-600 font-black"><%= locals.avg_progress || 0 %>% مكتمل</span>
                            </div>
                            <div class="w-full h-2.5 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-blue-500 via-emerald-500 to-green-600 rounded-full transition-all duration-500" style="width: <%= Math.max(5, locals.avg_progress || 0) %>%"></div>
                            </div>
                        </div>

                        <!-- Status Tags List -->
                        <div class="pt-2 flex flex-wrap gap-2 text-[11px]">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-900 dark:text-blue-300 font-bold">
                                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                                جارية: <%= locals.active_projects_count || 0 %>
                            </span>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-100 dark:bg-emerald-950 text-emerald-900 dark:text-emerald-300 font-bold">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                منجزة: <%= locals.completed_projects_count || 0 %>
                            </span>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-amber-100 dark:bg-amber-950 text-amber-900 dark:text-amber-300 font-bold">
                                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                مبرمجة: <%= locals.planned_projects_count || 0 %>
                            </span>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-purple-100 dark:bg-purple-950 text-purple-900 dark:text-purple-300 font-bold">
                                <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                                قيد الدراسة: <%= locals.study_projects_count || 0 %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Navigation Tabs for Admin Sections -->
        <div class="flex flex-wrap gap-2 border-b border-gray-200 dark:border-gray-800 mb-8 pb-3">
            <button type="button" onclick="switchAdminTab('tab-members')" id="btn-tab-members" class="admin-tab-btn active bg-blue-950 text-white px-5 py-2.5 rounded-2xl text-xs font-black transition shadow">
                👥 سجل المنخرطين (<%= users.length %>)
            </button>
            <button type="button" onclick="switchAdminTab('tab-projects')" id="btn-tab-projects" class="admin-tab-btn bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-100 px-5 py-2.5 rounded-2xl text-xs font-black transition border border-gray-200 dark:border-gray-800">
                📊 مشاريع وأنشطة الجمعية (<%= (locals.projects || []).length %>)
            </button>
            <button type="button" onclick="switchAdminTab('tab-honorary')" id="btn-tab-honorary" class="admin-tab-btn bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-100 px-5 py-2.5 rounded-2xl text-xs font-black transition border border-gray-200 dark:border-gray-800">
                ⭐ الأعضاء الشرفيون (<%= (locals.honorary_members || []).length %>)
            </button>
            <button type="button" onclick="switchAdminTab('tab-workshops')" id="btn-tab-workshops" class="admin-tab-btn bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-100 px-5 py-2.5 rounded-2xl text-xs font-black transition border border-gray-200 dark:border-gray-800">
                🎓 الورشات والتسجيلات (<%= (locals.workshops || []).length %> ورشات)
            </button>
            <button type="button" onclick="switchAdminTab('tab-proposals')" id="btn-tab-proposals" class="admin-tab-btn bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-100 px-5 py-2.5 rounded-2xl text-xs font-black transition border border-gray-200 dark:border-gray-800">
                💡 المقترحات التشاركية (<%= (locals.proposals || []).length %>)
            </button>
            <button type="button" onclick="switchAdminTab('tab-donations')" id="btn-tab-donations" class="admin-tab-btn bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-100 px-5 py-2.5 rounded-2xl text-xs font-black transition border border-gray-200 dark:border-gray-800">
                💖 عروض الدعم والشراكة (<%= (locals.donations || []).length %>)
            </button>
            <button type="button" onclick="switchAdminTab('tab-emails')" id="btn-tab-emails" class="admin-tab-btn bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-100 px-5 py-2.5 rounded-2xl text-xs font-black transition border border-gray-200 dark:border-gray-800">
                📨 سجل الإشعارات البريدية (<%= (locals.email_logs || []).length %>)
            </button>
            <button type="button" onclick="switchAdminTab('tab-card-sample')" id="btn-tab-card-sample" class="admin-tab-btn bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-100 px-5 py-2.5 rounded-2xl text-xs font-black transition border border-amber-300/60 dark:border-amber-500/40 flex items-center gap-1.5 text-amber-700 dark:text-amber-300">
                💳 <span>نموذج بطاقة العضوية</span>
            </button>
        </div>

        <!-- TAB 1: MEMBERS -->
        <div id="tab-members" class="admin-tab-pane">
            <!-- Filter & Search Controls -->
            <div class="bg-white dark:bg-gray-900 p-6 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-800 mb-8 flex flex-col md:flex-row gap-4 justify-between items-center">
                <div class="w-full md:w-80">
                    <input type="text" id="member-search" placeholder="🔍 ابحث بالاسم، الهاتف، أو الحي..." onkeyup="filterTable()" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-2xl text-xs outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div class="flex flex-wrap gap-2 w-full md:w-auto items-center">
                    <select id="quartier-filter" onchange="filterTable()" class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-xs p-2.5 rounded-xl font-bold outline-none">
                        <option value="all">كل الأحياء</option>
                        <option value="حي مولاي إسماعيل">حي مولاي إسماعيل</option>
                        <option value="حي الأمل">حي الأمل</option>
                        <option value="حي الفرح">حي الفرح</option>
                        <option value="حي الوفاق">حي الوفاق</option>
                        <option value="تجزئة النخيل">تجزئة النخيل</option>
                    </select>

                    <select id="cotisation-filter" onchange="filterTable()" class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-xs p-2.5 rounded-xl font-bold outline-none">
                        <option value="all">كل الاشتراكات</option>
                        <option value="مدفوع">مدفوع ✓</option>
                        <option value="في الانتظار">في الانتظار ⏳</option>
                    </select>

                    <button type="button" onclick="setFilterStatus('all')" class="status-btn active bg-blue-950 text-white px-4 py-2 rounded-xl text-xs font-bold transition">الكل (<%= users.length %>)</button>
                    <button type="button" onclick="setFilterStatus('قيد الانتظار')" class="status-btn bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 px-4 py-2 rounded-xl text-xs font-bold transition">قيد الانتظار (<%= pending_count %>)</button>
                    <button type="button" onclick="setFilterStatus('تم القبول')" class="status-btn bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 px-4 py-2 rounded-xl text-xs font-bold transition">معتمدون (<%= accepted_count %>)</button>
                </div>
            </div>

            <!-- Members Table -->
            <div class="bg-white dark:bg-gray-900 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
                <div class="p-6 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center">
                    <div>
                        <h2 class="text-xl font-black text-blue-950 dark:text-white"><%= currentLang === 'en' ? 'Members Registry' : 'سجل المنخرطين والأعضاء' %></h2>
                        <p class="text-xs text-gray-400 mt-0.5">إدارة ومراجعة بيانات بطاقات العضوية وواجبات الانخراط مع إشعار بريدي تلقائي</p>
                    </div>
                </div>
                <div class="overflow-x-auto p-2">
                    <table class="w-full <%= currentLang === 'en' ? 'text-left' : 'text-right' %> border-collapse" id="members-table">
                        <thead>
                            <tr class="text-gray-400 text-xs border-b border-gray-100 dark:border-gray-800">
                                <th class="pb-3 px-4 font-bold">العضو والهوية</th>
                                <th class="pb-3 px-4 font-bold">التواصل والحي</th>
                                <th class="pb-3 px-4 font-bold">الوضعية</th>
                                <th class="pb-3 px-4 font-bold">واجب الانخراط</th>
                                <th class="pb-3 px-4 font-bold text-center">الإجراء</th>
                            </tr>
                        </thead>
                        <tbody class="text-xs font-medium">
                            <% users.forEach(function(u) { %>
                            <tr class="member-row border-b border-gray-50 dark:border-gray-800/60 hover:bg-gray-50/80 dark:hover:bg-gray-800/40 transition-colors" data-status="<%= u.status %>" data-cotisation="<%= u.cotisation_status || 'في الانتظار' %>" data-quartier="<%= u.quartier || 'مدينة الدروة' %>">
                                <td class="py-4 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-gray-800 text-blue-900 dark:text-yellow-400 flex items-center justify-center font-bold text-base flex-shrink-0">
                                            <%= u.nom_complet.charAt(0) %>
                                        </div>
                                        <div class="overflow-hidden">
                                            <p class="font-black text-sm text-blue-950 dark:text-white truncate member-name"><%= u.nom_complet %></p>
                                            <p class="text-gray-400 text-[11px] font-mono mt-0.5"><%= u.membership_id || 'ASLD-2025-00' + u.id %> | <%= u.email %></p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <p class="font-bold text-gray-700 dark:text-gray-300 member-phone"><%= u.telephone || '-' %></p>
                                    <p class="text-gray-400 text-[11px] member-quartier">📍 <%= u.quartier || 'مدينة الدروة' %></p>
                                </td>
                                <td class="py-4 px-4">
                                    <% if (u.status === 'en_attente' || u.status === 'قيد الانتظار') { %>
                                        <span class="bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 px-3 py-1 rounded-lg font-black text-[11px]">⏳ قيد الانتظار</span>
                                    <% } else if (u.status === 'تم القبول' || u.status === 'valide') { %>
                                        <span class="bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 px-3 py-1 rounded-lg font-black text-[11px]">✓ معتمد</span>
                                    <% } else { %>
                                        <span class="bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300 px-3 py-1 rounded-lg font-black text-[11px]">✕ مرفوض</span>
                                    <% } %>
                                </td>
                                <td class="py-4 px-4">
                                    <a href="/admin/cotisation/<%= u.id %>" title="انقر لتعديل حالة الأداء" class="inline-block">
                                        <% if (u.cotisation_status === 'مدفوع') { %>
                                            <span class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-lg text-[10px] font-black transition cursor-pointer">
                                                100 MAD (مدفوع ✓)
                                            </span>
                                        <% } else { %>
                                            <span class="bg-gray-100 hover:bg-gray-200 text-gray-600 px-2.5 py-1 rounded-lg text-[10px] font-bold transition cursor-pointer">
                                                في الانتظار (تبديل ↻)
                                            </span>
                                        <% } %>
                                    </a>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="flex justify-center items-center gap-2">
                                        <button type="button" onclick="previewMemberCard('<%= (u.nom_complet || '').replace(/'/g, '\\\'') %>', '<%= u.membership_id || ('ASLD-2026-00' + u.id) %>', '<%= (u.quartier || 'مدينة الدروة').replace(/'/g, '\\\'') %>', '<%= u.cin || 'BK******' %>', '<%= u.cotisation_status || 'مدفوع' %>')" class="bg-blue-50 dark:bg-blue-950/60 hover:bg-blue-100 text-blue-900 dark:text-blue-300 border border-blue-200 dark:border-blue-800 px-2.5 py-1.5 rounded-xl font-bold transition text-xs flex items-center gap-1" title="معاينة نموذج بطاقة العضوية">
                                            💳 <span>بطاقة</span>
                                        </button>
                                        <% if (u.status !== 'تم القبول') { %>
                                            <a href="/valider_membre.php?id=<%= u.id %>&action=accepter" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-xl font-bold transition text-xs shadow-sm">
                                                قبول وتفعيل
                                            </a>
                                        <% } %>
                                        <% if (u.status !== 'مرفوض') { %>
                                            <a href="/valider_membre.php?id=<%= u.id %>&action=refuser" class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-xl font-bold transition text-xs">
                                                رفض
                                            </a>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 2: PROJECTS & STRATEGIC ACTIVITIES (المشاريع والأنشطة الميدانية) -->
        <div id="tab-projects" class="admin-tab-pane hidden">
            <!-- Header & Action Bar -->
            <div class="bg-white dark:bg-gray-900 rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100 dark:border-gray-800 mb-8">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 pb-6 border-b border-gray-100 dark:border-gray-800">
                    <div>
                        <div class="flex items-center gap-2.5">
                            <span class="w-10 h-10 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl font-black">📊</span>
                            <div>
                                <h2 class="text-xl md:text-2xl font-black text-blue-950 dark:text-white">إدارة مشاريع وأنشطة الجمعية</h2>
                                <p class="text-xs text-gray-400 mt-0.5">متابعة دقيقة لمبادرات الجمعية، حالات التقدم، الميزانيات، ولجان الإشراف</p>
                            </div>
                        </div>
                    </div>
                    <button type="button" onclick="toggleAddProjectForm()" class="bg-blue-950 hover:bg-blue-900 text-white px-5 py-2.5 rounded-2xl font-black text-xs transition flex items-center gap-2 shadow-sm">
                        <span>➕ إضافة مشروع جديد</span>
                    </button>
                </div>

                <!-- Status Filter Buttons -->
                <div class="flex flex-wrap gap-2 items-center">
                    <span class="text-xs font-bold text-gray-400 ml-2">تصفية حسب الحالة:</span>
                    <button type="button" onclick="filterProjectCards('all')" class="project-filter-btn active bg-blue-950 text-white px-4 py-1.5 rounded-xl text-xs font-black transition">
                        الكل (<%= (locals.projects || []).length %>)
                    </button>
                    <button type="button" onclick="filterProjectCards('en_cours')" class="project-filter-btn bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 px-4 py-1.5 rounded-xl text-xs font-black transition">
                        🔄 قيد التنفيذ (<%= locals.active_projects_count || 0 %>)
                    </button>
                    <button type="button" onclick="filterProjectCards('termine')" class="project-filter-btn bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 px-4 py-1.5 rounded-xl text-xs font-black transition">
                        ✅ منجز (<%= locals.completed_projects_count || 0 %>)
                    </button>
                    <button type="button" onclick="filterProjectCards('planifie')" class="project-filter-btn bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 px-4 py-1.5 rounded-xl text-xs font-black transition">
                        📅 مبرمج (<%= locals.planned_projects_count || 0 %>)
                    </button>
                    <button type="button" onclick="filterProjectCards('en_etude')" class="project-filter-btn bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 px-4 py-1.5 rounded-xl text-xs font-black transition">
                        🔍 قيد الدراسة (<%= locals.study_projects_count || 0 %>)
                    </button>
                </div>

                <!-- Add Project Collapsible Form -->
                <div id="add-project-form-container" class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-800 hidden">
                    <h3 class="text-base font-black text-blue-950 dark:text-white mb-4 flex items-center gap-2">
                        <span>📝</span> <span>استمارة تسجيل مشروع أو نشاط جديد</span>
                    </h3>
                    <form action="/admin/projects/add" method="POST" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div class="lg:col-span-2">
                            <label class="block text-xs font-bold text-gray-600 dark:text-gray-300 mb-1">اسم المشروع / المبادرة *</label>
                            <input type="text" name="title" required placeholder="مثال: القافلة الطبية التضامنية 2026" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-xs outline-none focus:ring-2 focus:ring-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 dark:text-gray-300 mb-1">المجال / الصنف *</label>
                            <select name="category" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-xs font-bold outline-none focus:ring-2 focus:ring-blue-600">
                                <option value="صحي وتضامني">صحي وتضامني</option>
                                <option value="بيئي وتطوعي">بيئي وتطوعي</option>
                                <option value="تكوين وتأهيل">تكوين وتأهيل</option>
                                <option value="رياضي وتربوي">رياضي وتربوي</option>
                                <option value="اجتماعي وتمكين">اجتماعي وتمكين الشباب</option>
                                <option value="ثقافي وفني">ثقافي وفني</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 dark:text-gray-300 mb-1">حالة المشروع *</label>
                            <select name="status" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-xs font-bold outline-none focus:ring-2 focus:ring-blue-600">
                                <option value="en_cours">قيد التنفيذ (En cours)</option>
                                <option value="planifie">مبرمج (Planifié)</option>
                                <option value="en_etude">قيد الدراسة (En étude)</option>
                                <option value="termine">منجز (Terminé)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 dark:text-gray-300 mb-1">نسبة الإنجاز (0-100%)</label>
                            <input type="number" name="progress" min="0" max="100" value="10" placeholder="مثال: 50" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-xs outline-none focus:ring-2 focus:ring-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 dark:text-gray-300 mb-1">الميزانية التقديرية</label>
                            <input type="text" name="budget" placeholder="مثال: 25,000 درهم" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-xs outline-none focus:ring-2 focus:ring-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 dark:text-gray-300 mb-1">الفئة المستهدفة</label>
                            <input type="text" name="beneficiaries" placeholder="مثال: 300 مستفيد بالدروة" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-xs outline-none focus:ring-2 focus:ring-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 dark:text-gray-300 mb-1">المشرف / اللجنة</label>
                            <input type="text" name="leader" placeholder="مثال: لجنة الشؤون الاجتماعية" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-xs outline-none focus:ring-2 focus:ring-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 dark:text-gray-300 mb-1">تاريخ البداية</label>
                            <input type="date" name="start_date" value="<%= new Date().toISOString().substring(0, 10) %>" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-xs outline-none focus:ring-2 focus:ring-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 dark:text-gray-300 mb-1">تاريخ الانتهاء المتوقع</label>
                            <input type="date" name="end_date" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-xs outline-none focus:ring-2 focus:ring-blue-600">
                        </div>
                        <div class="lg:col-span-2">
                            <label class="block text-xs font-bold text-gray-600 dark:text-gray-300 mb-1">وصف المشروع وأهدافه</label>
                            <input type="text" name="description" placeholder="تفاصيل مختصرة عن محاور المشروع وشركائه..." class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-xs outline-none focus:ring-2 focus:ring-blue-600">
                        </div>
                        <div class="lg:col-span-4 flex justify-end gap-3 mt-2">
                            <button type="button" onclick="toggleAddProjectForm()" class="px-5 py-2.5 rounded-xl text-xs font-bold text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
                                إلغاء
                            </button>
                            <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-7 py-2.5 rounded-xl font-black text-xs transition shadow-md">
                                حفظ المشروع في المنظومة ✓
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Projects Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% (locals.projects || []).forEach(p => { %>
                    <div class="project-card bg-white dark:bg-gray-900 rounded-3xl p-6 shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col justify-between transition hover:shadow-md" data-status="<%= p.status %>">
                        <div>
                            <!-- Category and Status Badges -->
                            <div class="flex justify-between items-start gap-2 mb-4">
                                <span class="bg-slate-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 px-3 py-1 rounded-xl text-[11px] font-black">
                                    🏷️ <%= p.category || 'عام' %>
                                </span>

                                <% if (p.status === 'en_cours') { %>
                                    <span class="bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/60 px-3 py-1 rounded-xl text-[11px] font-black flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
                                        قيد التنفيذ
                                    </span>
                                <% } else if (p.status === 'termine') { %>
                                    <span class="bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 px-3 py-1 rounded-xl text-[11px] font-black flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                        منجز بنجاح ✓
                                    </span>
                                <% } else if (p.status === 'planifie') { %>
                                    <span class="bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60 px-3 py-1 rounded-xl text-[11px] font-black flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                        مبرمج مستقبلاً
                                    </span>
                                <% } else { %>
                                    <span class="bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/60 px-3 py-1 rounded-xl text-[11px] font-black flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                                        قيد الدراسة
                                    </span>
                                <% } %>
                            </div>

                            <!-- Title & Description -->
                            <h3 class="font-black text-lg text-blue-950 dark:text-white mb-2 leading-snug">
                                <%= p.title %>
                            </h3>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mb-5 line-clamp-3 leading-relaxed">
                                <%= p.description || 'مشروع ميداني تتبناه الجمعية لخدمة الساكنة المحلية وتعزيز التنمية المندمجة.' %>
                            </p>

                            <!-- Progress Bar -->
                            <div class="mb-5 bg-slate-50 dark:bg-gray-800/50 p-3.5 rounded-2xl border border-gray-100 dark:border-gray-800">
                                <div class="flex justify-between items-center text-xs font-bold mb-1.5">
                                    <span class="text-gray-500 dark:text-gray-400">نسبة التقدم والإنجاز</span>
                                    <span class="font-black <%= p.progress >= 100 ? 'text-emerald-600' : 'text-blue-600 dark:text-yellow-400' %>">
                                        <%= p.progress || 0 %>%
                                    </span>
                                </div>
                                <div class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                                    <div class="h-full <%= p.progress >= 100 ? 'bg-emerald-500' : 'bg-gradient-to-r from-blue-500 to-indigo-600' %> rounded-full transition-all duration-300" style="width: <%= p.progress || 0 %>%"></div>
                                </div>
                            </div>

                            <!-- Key Project Facts Grid -->
                            <div class="grid grid-cols-2 gap-2 text-[11px] mb-5">
                                <div class="bg-gray-50 dark:bg-gray-800/60 p-2.5 rounded-xl">
                                    <span class="text-gray-400 block font-bold">الميزانية:</span>
                                    <span class="font-black text-blue-950 dark:text-white"><%= p.budget || '-' %></span>
                                </div>
                                <div class="bg-gray-50 dark:bg-gray-800/60 p-2.5 rounded-xl">
                                    <span class="text-gray-400 block font-bold">المستفيدين:</span>
                                    <span class="font-black text-blue-950 dark:text-white"><%= p.beneficiaries || '-' %></span>
                                </div>
                                <div class="bg-gray-50 dark:bg-gray-800/60 p-2.5 rounded-xl">
                                    <span class="text-gray-400 block font-bold">المشرف:</span>
                                    <span class="font-black text-blue-950 dark:text-white truncate block"><%= p.leader || 'المكتب التنفيذي' %></span>
                                </div>
                                <div class="bg-gray-50 dark:bg-gray-800/60 p-2.5 rounded-xl">
                                    <span class="text-gray-400 block font-bold">الفترة:</span>
                                    <span class="font-black text-blue-950 dark:text-white truncate block"><%= p.start_date || '2026' %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Status & Progress Quick Update Form -->
                        <div class="pt-4 border-t border-gray-100 dark:border-gray-800">
                            <form action="/admin/projects/<%= p.id %>/status" method="POST" class="flex items-center gap-2 mb-2">
                                <select name="status" class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-[11px] font-bold p-2 rounded-xl outline-none flex-1">
                                    <option value="en_cours" <%= p.status === 'en_cours' ? 'selected' : '' %>>قيد التنفيذ</option>
                                    <option value="termine" <%= p.status === 'termine' ? 'selected' : '' %>>منجز</option>
                                    <option value="planifie" <%= p.status === 'planifie' ? 'selected' : '' %>>مبرمج</option>
                                    <option value="en_etude" <%= p.status === 'en_etude' ? 'selected' : '' %>>قيد الدراسة</option>
                                </select>
                                <input type="number" name="progress" min="0" max="100" value="<%= p.progress || 0 %>" title="النسبة %" class="w-16 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-[11px] font-bold p-2 rounded-xl text-center outline-none">
                                <button type="submit" class="bg-blue-950 hover:bg-blue-900 text-white px-3 py-2 rounded-xl text-[11px] font-black transition">
                                    تعديل ✓
                                </button>
                            </form>
                            <div class="flex justify-between items-center text-[10px] text-gray-400 px-1 pt-2 border-t border-gray-100 dark:border-gray-800">
                                <span>المعرف: #<%= p.id %></span>
                                <form action="/admin/projects/delete/<%= p.id %>" method="POST" class="inline m-0">
                                    <button type="submit" class="text-red-500 hover:text-red-700 font-bold hover:underline py-1 px-2.5 rounded-lg bg-red-50 dark:bg-red-950/40 text-[11px] transition flex items-center gap-1 cursor-pointer">
                                        <span>🗑️ حذف المشروع</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>

                <% if (!locals.projects || locals.projects.length === 0) { %>
