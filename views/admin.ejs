    <script>
        let currentStatusFilter = 'all';

        // Tab Switching
        function switchAdminTab(tabId) {
            document.querySelectorAll('.admin-tab-pane').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.admin-tab-btn').forEach(btn => {
                btn.classList.remove('bg-blue-950', 'text-white', 'shadow');
                btn.classList.add('bg-white', 'dark:bg-gray-900', 'text-gray-700', 'dark:text-gray-300');
            });

            const activePane = document.getElementById(tabId);
            if (activePane) activePane.classList.remove('hidden');

            const activeBtn = document.getElementById('btn-' + tabId);
            if (activeBtn) {
                activeBtn.classList.add('bg-blue-950', 'text-white', 'shadow');
                activeBtn.classList.remove('bg-white', 'dark:bg-gray-900', 'text-gray-700', 'dark:text-gray-300');
            }
        }

        // Handle URL hash for tabs
        window.addEventListener('DOMContentLoaded', () => {
            if (window.location.hash === '#projects-tab') {
                switchAdminTab('tab-projects');
            } else if (window.location.hash === '#proposals-tab') {
                switchAdminTab('tab-proposals');
            } else if (window.location.hash === '#honorary-tab') {
                switchAdminTab('tab-honorary');
            } else if (window.location.hash === '#workshops-tab') {
                switchAdminTab('tab-workshops');
            } else if (window.location.hash === '#card-sample-tab') {
                switchAdminTab('tab-card-sample');
            }
        });

        // Membership Card Specimen Functions
        function previewMemberCard(name, memId, quartier, cin, cotisation) {
            document.getElementById('specimen-input-name').value = name || 'إبراهيم أيت الديمان';
            document.getElementById('specimen-input-id').value = memId || 'ASLD-2026-00101';
            document.getElementById('specimen-input-quartier').value = quartier || 'مدينة الدروة';
            updateCardPreview();
            switchAdminTab('tab-card-sample');
            document.getElementById('tab-card-sample').scrollIntoView({ behavior: 'smooth' });
        }

        function onSpecimenSelectMember(selectEl) {
            if (selectEl.value === 'default') {
                resetCardSpecimen();
                return;
            }
            const opt = selectEl.options[selectEl.selectedIndex];
            document.getElementById('specimen-input-name').value = opt.dataset.name || '';
            document.getElementById('specimen-input-id').value = opt.dataset.id || '';
            document.getElementById('specimen-input-quartier').value = opt.dataset.quartier || '';
            updateCardPreview();
        }

        function updateCardPreview() {
            const name = document.getElementById('specimen-input-name').value.trim() || 'إبراهيم أيت الديمان';
            const memId = document.getElementById('specimen-input-id').value.trim() || 'ASLD-2026-00101';
            const quartier = document.getElementById('specimen-input-quartier').value.trim() || 'مدينة الدروة';

            document.getElementById('specimen-display-name').textContent = name;
            document.getElementById('specimen-display-id').textContent = memId;
            document.getElementById('specimen-display-quartier').textContent = '📍 ' + quartier;
            document.getElementById('specimen-avatar').textContent = name.charAt(0);
            
            const qrImg = document.getElementById('specimen-qr-code');
            if (qrImg) {
                qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=90x90&data=ASLD-VERIFIED-${encodeURIComponent(memId)}`;
            }
        }

        function resetCardSpecimen() {
            document.getElementById('specimen-input-name').value = 'إبراهيم أيت الديمان';
            document.getElementById('specimen-input-id').value = 'ASLD-2026-00101';
            document.getElementById('specimen-input-quartier').value = 'حي الوفاء - الدروة';
            const selector = document.getElementById('specimen-member-selector');
            if (selector) selector.value = 'default';
            updateCardPreview();
        }

        function printMembershipCard() {
            window.print();
        }

        // Toggle Add Project Form
        function toggleAddProjectForm() {
            const formContainer = document.getElementById('add-project-form-container');
            if (formContainer) {
                formContainer.classList.toggle('hidden');
                if (!formContainer.classList.contains('hidden')) {
                    formContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        }

        // Filter Project Cards by Status
        function filterProjectCards(status) {
            const cards = document.querySelectorAll('.project-card');
            cards.forEach(card => {
                if (status === 'all' || card.dataset.status === status) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });

            // Update button styles
            const buttons = document.querySelectorAll('.project-filter-btn');
            buttons.forEach(btn => {
                btn.classList.remove('bg-blue-950', 'text-white', 'active');
                btn.classList.add('bg-gray-100', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');
            });
            if (event && event.currentTarget) {
                event.currentTarget.classList.add('bg-blue-950', 'text-white', 'active');
                event.currentTarget.classList.remove('bg-gray-100', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');
            }
        }

        function setFilterStatus(status) {
            currentStatusFilter = status;
            const buttons = document.querySelectorAll('.status-btn');
            buttons.forEach(btn => {
                if (btn.textContent.includes(status) || (status === 'all' && btn.textContent.includes('الكل'))) {
                    btn.classList.add('bg-blue-950', 'text-white');
                    btn.classList.remove('bg-gray-100', 'text-gray-600');
                } else {
                    btn.classList.remove('bg-blue-950', 'text-white');
                    btn.classList.add('bg-gray-100', 'text-gray-600');
                }
            });
            filterTable();
        }

        function filterTable() {
            const query = document.getElementById('member-search').value.toLowerCase().trim();
            const quartierFilter = document.getElementById('quartier-filter').value;
            const cotisationFilter = document.getElementById('cotisation-filter').value;
            const rows = document.querySelectorAll('.member-row');

            rows.forEach(row => {
                const status = row.dataset.status;
                const cotisation = row.dataset.cotisation;
                const quartier = row.dataset.quartier;
                const name = row.querySelector('.member-name').textContent.toLowerCase();
                const phone = row.querySelector('.member-phone').textContent.toLowerCase();

                const matchesStatus = (currentStatusFilter === 'all') || (status === currentStatusFilter);
                const matchesQuartier = (quartierFilter === 'all') || (quartier.includes(quartierFilter));
                const matchesCotisation = (cotisationFilter === 'all') || (cotisation === cotisationFilter);
                const matchesQuery = !query || name.includes(query) || phone.includes(query) || quartier.toLowerCase().includes(query);

                if (matchesStatus && matchesQuartier && matchesCotisation && matchesQuery) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>
