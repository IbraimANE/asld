<!DOCTYPE html>
<html lang="<%= lang.lang_code %>" dir="<%= lang.direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentLang === 'en' ? 'Article Moderation | Association Admin' : 'مراجعة المقالات والأنشطة | إدارة الجمعية' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/custom.css">
    <style>body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; }</style>
</head>
<body class="text-gray-800">

    <nav class="bg-blue-950 text-white p-5 shadow-2xl sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center gap-4">
                <a href="/index.php">
                    <img src="/image/logo_assoc.jpg" class="h-12 w-auto rounded-xl bg-white p-0.5" alt="Logo">
                </a>
                <h1 class="text-2xl font-black tracking-wide"><%= currentLang === 'en' ? 'Article Moderation' : 'إدارة ومراجعة المقالات' %></h1>
            </div>
            <div class="flex items-center gap-3">
                <a href="/admin.php" class="bg-indigo-700/80 px-4 py-2 rounded-xl font-bold hover:bg-indigo-600 transition text-sm">
                    👥 <%= currentLang === 'en' ? 'Manage Members' : 'إدارة الأعضاء' %>
                </a>
                <a href="/index.php" class="bg-white/10 px-4 py-2 rounded-xl font-bold hover:bg-white/20 transition text-sm"><%= lang.nav_home %></a>
                <a href="/logout.php" class="bg-red-500 px-4 py-2 rounded-xl font-bold hover:bg-red-600 transition shadow-lg shadow-red-500/30 text-sm"><%= lang.logout %></a>
            </div>
        </div>
    </nav>

    <div class="container mx-auto py-12 px-6">
        
        <div class="flex justify-between items-center mb-8">
            <div>
                <h2 class="text-3xl font-black text-[#122A4E]"><%= currentLang === 'en' ? 'Activities & Initiatives Moderation' : 'مراجعة أنشطة ومبادرات الأعضاء' %></h2>
                <p class="text-gray-500 text-sm mt-1"><%= currentLang === 'en' ? 'Approve submitted initiatives to publish them on the public portal' : 'المصادقة على المبادرات المقترحة ونشرها بالبوابة الرئيسية للموقع' %></p>
            </div>
            <div class="bg-white px-5 py-3 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-3">
                <span class="text-sm font-bold text-gray-500"><%= currentLang === 'en' ? 'Total Initiatives:' : 'إجمالي المبادرات:' %></span>
                <span class="text-xl font-black text-blue-950"><%= articles.length %></span>
            </div>
        </div>

        <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full <%= currentLang === 'en' ? 'text-left' : 'text-right' %> border-collapse">
                    <thead class="bg-gray-50 border-b border-gray-100 text-gray-400 text-xs uppercase font-bold">
                        <tr>
                            <th class="py-4 px-6"><%= currentLang === 'en' ? 'Initiative' : 'المبادرة والنشاط' %></th>
                            <th class="py-4 px-6"><%= currentLang === 'en' ? 'Category' : 'المجال' %></th>
                            <th class="py-4 px-6"><%= currentLang === 'en' ? 'Author' : 'الناشر' %></th>
                            <th class="py-4 px-6"><%= currentLang === 'en' ? 'Date' : 'تاريخ الإرسال' %></th>
                            <th class="py-4 px-6"><%= currentLang === 'en' ? 'Status' : 'الحالة' %></th>
                            <th class="py-4 px-6 text-center"><%= currentLang === 'en' ? 'Actions' : 'الإجراءات' %></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        <% articles.forEach(function(art) { %>
                        <tr class="hover:bg-gray-50/80 transition-colors">
                            <td class="py-5 px-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-16 h-12 rounded-xl bg-gray-100 overflow-hidden flex-shrink-0">
                                        <img src="<%= art.image_article || 'https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?w=300' %>" class="w-full h-full object-cover" alt="Thumb">
                                    </div>
                                    <div>
                                        <a href="/article_details.php?id=<%= art.id %>" class="font-black text-blue-950 hover:text-blue-600 transition-colors block">
                                            <%= art.titre %>
                                        </a>
                                        <p class="text-gray-400 text-xs line-clamp-1 mt-0.5"><%= art.contenu.substring(0, 70) %>...</p>
                                    </div>
                                </div>
                            </td>
                            <td class="py-5 px-6">
                                <span class="bg-blue-50 text-blue-800 text-xs px-3 py-1 rounded-full font-bold">
                                    <%= art.category || 'عام' %>
                                </span>
                            </td>
                            <td class="py-5 px-6 font-bold text-gray-700"><%= art.nom_complet %></td>
                            <td class="py-5 px-6 text-gray-500 font-mono text-xs"><%= art.date_publication %></td>
                            <td class="py-5 px-6">
                                <% if (art.status === 'publie') { %>
                                    <span class="bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-lg font-black">✓ <%= currentLang === 'en' ? 'Published' : 'منشور' %></span>
                                <% } else { %>
                                    <span class="bg-amber-100 text-amber-800 text-xs px-3 py-1 rounded-lg font-black">⏳ <%= currentLang === 'en' ? 'Pending' : 'قيد المراجعة' %></span>
                                <% } %>
                            </td>
                            <td class="py-5 px-6">
                                <div class="flex justify-center items-center gap-2">
                                    <% if (art.status !== 'publie') { %>
                                        <a href="/admin_articles.php?action=valider&id=<%= art.id %>" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-xl text-xs font-bold shadow transition">
                                            <%= currentLang === 'en' ? 'Approve' : 'نشر بالموقع' %>
                                        </a>
                                    <% } %>
                                    <a href="/article_details.php?id=<%= art.id %>" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-xl text-xs font-bold transition">
                                        <%= currentLang === 'en' ? 'Preview' : 'معاينة' %>
                                    </a>
                                    <a href="/admin_articles.php?action=supprimer&id=<%= art.id %>" onclick="return confirm('<%= currentLang === 'en' ? 'Confirm deletion of this article?' : 'هل أنت متأكد من حذف هذا المقال؟' %>')" class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-xl text-xs font-bold transition">
                                        <%= currentLang === 'en' ? 'Delete' : 'حذف' %>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
