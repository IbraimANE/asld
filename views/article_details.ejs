<!DOCTYPE html>
<html lang="<%= lang.lang_code %>" dir="<%= lang.direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= article.titre %> | <%= lang.site_title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="/custom.css">
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; }
        .sticky-ad { position: sticky; top: 100px; }
    </style>
</head>
<body class="leading-normal tracking-normal text-gray-800">

    <%- include('partials/nav') %>

    <div class="container mx-auto py-12 px-4">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
            <div class="hidden lg:block lg:col-span-1">
                <div class="sticky-ad bg-white p-4 rounded-2xl shadow-sm border border-gray-100 text-center" data-aos="<%= currentLang === 'en' ? 'fade-right' : 'fade-left' %>">
                    <p class="text-[11px] text-gray-400 mb-2 uppercase font-bold"><%= lang.ad_sponsored %></p>
                    <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 text-center">
                        <div class="text-3xl mb-2">🤝</div>
                        <p class="text-xs font-black text-blue-900">دار الشباب دروة</p>
                        <p class="text-[10px] text-gray-500 mt-1">شريك التنمية المجتمعية</p>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-3 bg-white shadow-2xl shadow-gray-200/50 rounded-[2.5rem] p-8 md:p-12 border border-gray-50" data-aos="fade-up">
                <div class="flex justify-center mb-6">
                    <span class="bg-blue-50 text-blue-700 text-xs font-black px-5 py-2 rounded-full border border-blue-100">
                        📂 <%= currentLang === 'en' ? 'Category: ' : 'قسم: ' %><%= article.category || 'عام' %>
                    </span>
                </div>
                <h1 class="text-3xl md:text-5xl font-black text-[#122a4e] mb-8 text-center leading-tight">
                    <%= article.titre %>
                </h1>
                <div class="flex flex-wrap items-center justify-center text-gray-400 text-sm mb-10 border-y py-4 border-gray-50 gap-4">
                    <span>👤 <%= lang.author_prefix %> <strong class="text-gray-700"><%= article.nom_complet || 'عضو الجمعية' %></strong></span>
                    <span>📅 <%= lang.date_prefix %> <strong class="text-gray-700"><%= article.date_publication %></strong></span>
                </div>
                
                <% if (article.image_article) { %>
                    <img src="<%= article.image_article %>" class="w-full max-w-2xl mx-auto rounded-3xl shadow-xl mb-12 border-8 border-gray-50 object-cover" alt="Article image">
                <% } %>

                <div class="text-lg md:text-xl leading-loose text-gray-700 text-justify space-y-6">
                    <p><%= article.contenu %></p>
                </div>

                <div class="mt-12 pt-6 border-t border-gray-100 flex justify-between items-center">
                    <a href="/index.php#activities" class="bg-blue-900 text-white px-8 py-3 rounded-xl font-bold hover:bg-blue-800 transition-colors shadow-md">
                        <%= lang.back_home %>
                    </a>
                    <span class="text-sm font-bold text-gray-400">جمعية مبادرات بلا حدود</span>
                </div>
            </div>

            <div class="hidden lg:block lg:col-span-1">
                <div class="sticky-ad bg-white p-4 rounded-2xl shadow-sm border border-gray-100 text-center" data-aos="<%= currentLang === 'en' ? 'fade-left' : 'fade-right' %>">
                    <p class="text-[11px] text-gray-400 mb-2 uppercase font-bold"><%= lang.ad_sponsored %></p>
                    <div class="bg-yellow-50 border border-yellow-100 rounded-xl p-4 text-center">
                        <div class="text-3xl mb-2">⭐</div>
                        <p class="text-xs font-black text-yellow-900">مبادرة انخراط 2026</p>
                        <p class="text-[10px] text-gray-500 mt-1">واجب الاشتراك 100 درهم</p>
                        <a href="/inscription.php" class="mt-3 inline-block bg-yellow-400 text-blue-950 text-[11px] font-black px-3 py-1.5 rounded-lg hover:bg-yellow-300">انضم إلينا</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init({ duration: 800, once: true });</script>
</body>
</html>
