<!DOCTYPE html>
<html lang="<%= lang.lang_code %>" dir="<%= lang.direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentLang === 'en' ? 'Contact Us | Boundless Initiatives' : 'اتصل بنا | مبادرات بلا حدود' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="/custom.css">
    <script>
        tailwind.config = {
            darkMode: 'class'
        }
    </script>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 transition-colors">

    <%- include('partials/nav') %>

    <header class="hero-clean-bg py-14 px-6 text-center border-b border-slate-200 dark:border-slate-800">
        <div class="container mx-auto" data-aos="fade-down">
            <span class="section-badge-clean">
                <span>📬</span>
                <span>Get In Touch</span>
            </span>
            <h1 class="text-3xl md:text-5xl font-black text-[#0e244d] dark:text-white mt-3 mb-2"><%= lang.contact_title %></h1>
            <p class="text-slate-500 dark:text-slate-400 text-sm md:text-base max-w-xl mx-auto"><%= lang.contact_subtitle %></p>
            <div class="clean-divider">
                <div class="clean-divider-line"></div>
                <div class="clean-divider-diamond"></div>
                <div class="clean-divider-line"></div>
            </div>
        </div>
    </header>

    <div class="container mx-auto py-12 px-4">
        <% if (locals.messageSent) { %>
            <div class="max-w-2xl mx-auto mb-8 bg-emerald-50 dark:bg-slate-900 border border-emerald-300 dark:border-emerald-700 text-emerald-800 dark:text-emerald-300 p-5 rounded-2xl text-center font-bold shadow-sm">
                <span class="text-2xl block mb-1">✅</span>
                <%= currentLang === 'en' ? 'Thank you! Your message has been received and our team will get in touch with you shortly.' : 'شكراً لك! تم استلام رسالتك بنجاح وسيقوم فريق الجمعية بالتواصل معك في أقرب وقت.' %>
            </div>
        <% } %>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start max-w-5xl mx-auto">
            <div class="clean-card p-8 md:p-10 relative overflow-hidden" data-aos="fade-left">
                <div class="brand-accent-line absolute top-0 left-0 right-0"></div>
                <h3 class="text-lg font-black text-[#0e244d] dark:text-white mb-6"><%= currentLang === 'en' ? 'Direct Communication Form' : 'استمارة التواصل المباشر' %></h3>
                <form action="/contact.php" method="POST" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input type="text" name="nom" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs sm:text-sm outline-none focus:border-[#0e244d] dark:focus:border-amber-400 font-medium" placeholder="<%= currentLang === 'en' ? 'Full Name' : 'الاسم الكامل' %>">
                        <input type="email" name="email" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs sm:text-sm outline-none focus:border-[#0e244d] dark:focus:border-amber-400 font-medium" placeholder="<%= currentLang === 'en' ? 'Email Address' : 'البريد الإلكتروني' %>">
                    </div>
                    <input type="text" name="sujet" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs sm:text-sm outline-none focus:border-[#0e244d] dark:focus:border-amber-400 font-medium" placeholder="<%= currentLang === 'en' ? 'Subject' : 'موضوع الرسالة' %>">
                    <textarea name="message" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-xl text-xs sm:text-sm h-36 outline-none focus:border-[#0e244d] dark:focus:border-amber-400 font-medium" placeholder="<%= currentLang === 'en' ? 'Your message here...' : 'رسالتك هنا...' %>"></textarea>
                    <button type="submit" class="w-full btn-solid-navy py-3.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm transition">
                        <%= currentLang === 'en' ? 'Send Message ✉️' : 'إرسال الرسالة ✉️' %>
                    </button>
                </form>
            </div>

            <div class="space-y-6" data-aos="fade-right">
                <div class="clean-card p-8 bg-[#0e244d] text-white border-[#0e244d] dark:border-slate-800">
                    <h3 class="text-lg font-black mb-6 border-b border-white/10 pb-3 text-amber-300"><%= currentLang === 'en' ? 'Contact Information' : 'معلومات التواصل' %></h3>
                    <div class="space-y-5">
                        <p class="flex items-center gap-3 text-slate-100 text-xs sm:text-sm font-medium">
                            <span class="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center text-lg flex-shrink-0">📍</span> 
                            <span><%= lang.contact_hq %></span>
                        </p>
                        <p class="flex items-center gap-3 text-slate-100 text-xs sm:text-sm font-medium">
                            <span class="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center text-lg flex-shrink-0">📞</span> 
                            <span><%= lang.contact_phone %> +212 661 00 00 00 / 0522 00 00 00</span>
                        </p>
                        <p class="flex items-center gap-3 text-slate-100 text-xs sm:text-sm font-medium">
                            <span class="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center text-lg flex-shrink-0">✉️</span> 
                            <span><%= lang.contact_email %> contact@assoc.ma</span>
                        </p>
                    </div>
                </div>
                <div class="h-60 clean-card overflow-hidden p-1 bg-slate-100 dark:bg-slate-800">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d106450.48512135652!2d-7.65!3d33.4!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xda631622345e69b%3A0x7d6a5c102a0a256!2sDeroua!5e0!3m2!1sfr!2sma!4v1680000000000!5m2!1sfr!2sma" width="100%" height="100%" style="border:0;" loading="lazy"></iframe>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init({ duration: 800, once: true });</script>
</body>
</html>
