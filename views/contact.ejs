<!DOCTYPE html>
<html lang="<%= lang.lang_code %>" dir="<%= lang.direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentLang === 'en' ? 'Contact Us | Boundless Initiatives' : 'اتصل بنا | مبادرات بلا حدود' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="/custom.css">
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; }
        .hero-mini { background: linear-gradient(135deg, #122a4e 0%, #1a365d 100%); }
    </style>
</head>
<body class="text-gray-800">

    <%- include('partials/nav') %>

    <header class="hero-mini text-white py-16 px-6 text-center shadow-lg">
        <div class="container mx-auto" data-aos="fade-down">
            <h1 class="text-4xl md:text-5xl font-black mb-4 text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-orange-400"><%= lang.contact_title %></h1>
            <p class="text-blue-100/80 max-w-xl mx-auto"><%= lang.contact_subtitle %></p>
        </div>
    </header>

    <div class="container mx-auto py-16 px-4">
        <% if (locals.messageSent) { %>
            <div class="max-w-2xl mx-auto mb-8 bg-emerald-50 border-2 border-emerald-300 text-emerald-800 p-6 rounded-3xl text-center font-bold shadow-md">
                <span class="text-3xl block mb-2">✅</span>
                <%= currentLang === 'en' ? 'Thank you! Your message has been received and our team will get in touch with you shortly.' : 'شكراً لك! تم استلام رسالتك بنجاح وسيقوم فريق الجمعية بالتواصل معك في أقرب وقت.' %>
            </div>
        <% } %>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start max-w-6xl mx-auto">
            <div class="bg-white p-10 rounded-[2.5rem] shadow-2xl shadow-blue-900/5 border border-gray-50" data-aos="fade-left">
                <form action="/contact.php" method="POST" class="space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input type="text" name="nom" required class="w-full bg-gray-50 border border-gray-100 p-4 rounded-2xl outline-none focus:ring-4 focus:ring-blue-500/10 transition" placeholder="<%= currentLang === 'en' ? 'Full Name' : 'الاسم الكامل' %>">
                        <input type="email" name="email" required class="w-full bg-gray-50 border border-gray-100 p-4 rounded-2xl outline-none focus:ring-4 focus:ring-blue-500/10 transition" placeholder="<%= currentLang === 'en' ? 'Email Address' : 'البريد الإلكتروني' %>">
                    </div>
                    <input type="text" name="sujet" required class="w-full bg-gray-50 border border-gray-100 p-4 rounded-2xl outline-none focus:ring-4 focus:ring-blue-500/10 transition" placeholder="<%= currentLang === 'en' ? 'Subject' : 'موضوع الرسالة' %>">
                    <textarea name="message" required class="w-full bg-gray-50 border border-gray-100 p-4 rounded-2xl h-40 outline-none focus:ring-4 focus:ring-blue-500/10 transition" placeholder="<%= currentLang === 'en' ? 'Your message here...' : 'رسالتك هنا...' %>"></textarea>
                    <button type="submit" class="w-full bg-[#122a4e] text-white py-4 rounded-2xl font-black text-lg hover:bg-blue-900 transition-all shadow-xl shadow-blue-900/20">
                        <%= currentLang === 'en' ? 'Send Message ✉️' : 'إرسال الرسالة ✉️' %>
                    </button>
                </form>
            </div>

            <div class="space-y-8" data-aos="fade-right">
                <div class="bg-gradient-to-br from-[#122a4e] to-[#2C69B3] text-white p-10 rounded-[2.5rem] shadow-xl">
                    <h3 class="text-2xl font-black mb-8 border-b border-white/10 pb-4"><%= currentLang === 'en' ? 'Contact Information' : 'معلومات التواصل' %></h3>
                    <div class="space-y-6">
                        <p class="flex items-center gap-4 text-blue-50 font-medium">
                            <span class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center text-xl flex-shrink-0">📍</span> 
                            <span><%= lang.contact_hq %></span>
                        </p>
                        <p class="flex items-center gap-4 text-blue-50 font-medium">
                            <span class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center text-xl flex-shrink-0">📞</span> 
                            <span><%= lang.contact_phone %> +212 661 00 00 00 / 0522 00 00 00</span>
                        </p>
                        <p class="flex items-center gap-4 text-blue-50 font-medium">
                            <span class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center text-xl flex-shrink-0">✉️</span> 
                            <span><%= lang.contact_email %> contact@assoc.ma</span>
                        </p>
                    </div>
                </div>
                <div class="h-64 rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-white bg-gray-100 flex items-center justify-center relative">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d106450.48512135652!2d-7.65!3d33.4!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xda631622345e69b%3A0x7d6a5c102a0a256!2sDeroua!5e0!3m2!1sfr!2sma!4v1680000000000!5m2!1sfr!2sma" width="100%" height="100%" style="border:0;" loading="lazy"></iframe>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init({ duration: 800, once: true });</script>
</body>
</html>
