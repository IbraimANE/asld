<!DOCTYPE html>
<html lang="<%= lang.lang_code %>" dir="<%= lang.direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentLang === 'en' ? 'Member Portal | Boundless Initiatives' : (currentLang === 'fr' ? 'Espace Membre | Initiatives Sans Frontières' : 'فضاء العضوية | مبادرات بلا حدود') %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            blue: '#122a4e',
                            green: '#4AB76B',
                            yellow: '#f59e0b'
                        }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="/custom.css">
    <style>
        body { font-family: 'Tajawal', sans-serif; }
        @media print {
            body * { visibility: hidden; }
            #printable-membership-card, #printable-membership-card * { visibility: visible; }
            #printable-membership-card {
                position: absolute;
                left: 50%;
                top: 50%;
                transform: translate(-50%, -50%);
                width: 450px !important;
                box-shadow: none !important;
                border: 2px solid #122a4e !important;
            }
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-gray-950 text-gray-800 dark:text-gray-100 transition-colors">

    <%- include('partials/nav') %>

    <% if (user.status !== 'تم القبول' && user.status !== 'valide') { %>
        <div class="container mx-auto py-24 px-6 text-center max-w-lg">
            <div class="bg-white dark:bg-gray-900 p-10 rounded-[2.5rem] shadow-xl border border-amber-100 dark:border-gray-800">
                <div class="text-6xl mb-4">⏳</div>
                <h2 class="text-2xl font-black text-[#122a4e] dark:text-white mb-3">
                    <%= currentLang === 'en' ? 'Account Pending Activation' : 'حسابك قيد التفعيل والمراجعة' %>
                </h2>
                <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed text-sm">
                    <%= currentLang === 'en' ? 'Your membership application is being reviewed by the association administration. You will be notified as soon as it is approved.' : 'طلب عضويتك قيد المراجعة والتحقق من الوثائق بواسطة إدارة الجمعية. ستتمكن من نشر الأنشطة فور تفعيل الحساب.' %>
                </p>
                <div class="flex justify-center gap-3">
                    <a href="/index.php" class="bg-blue-900 text-white px-6 py-2.5 rounded-xl font-bold hover:bg-blue-800 transition text-sm"><%= lang.back_home %></a>
                    <a href="/logout.php" class="bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 px-6 py-2.5 rounded-xl font-bold hover:bg-gray-200 transition text-sm"><%= lang.logout %></a>
                </div>
            </div>
        </div>
    <% } else { %>

    <div class="container mx-auto py-12 px-4 max-w-6xl">
        
        <!-- Welcome Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-10 bg-white dark:bg-gray-900 p-8 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-800">
            <div>
                <span class="text-xs font-black uppercase text-emerald-600 dark:text-emerald-400">Espace Adhérent</span>
                <h1 class="text-2xl md:text-3xl font-black text-blue-950 dark:text-white">
                    <%= currentLang === 'en' ? 'Welcome back, ' : (currentLang === 'fr' ? 'Bienvenue, ' : 'مرحباً بك، ') %><%= user.nom_complet %>
                </h1>
                <p class="text-xs text-gray-400 mt-1">عضوية معتمدة برقم: <strong class="text-blue-900 dark:text-yellow-400 font-mono"><%= user.membership_id || 'ASLD-2025-00' + user.id %></strong></p>
            </div>
            <div class="flex gap-2">
                <button type="button" onclick="window.print()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl font-bold text-xs shadow flex items-center gap-2">
                    🖨️ <%= lang.print_card %>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Left Col: Digital Membership Card -->
            <div class="lg:col-span-1">
                <div class="sticky top-28 space-y-6">
                    
                    <!-- Printable Digital Card -->
                    <div id="printable-membership-card" class="bg-gradient-to-br from-[#122a4e] via-[#1a3867] to-[#0f172a] text-white p-6 rounded-3xl shadow-2xl border-2 border-yellow-400/40 relative overflow-hidden">
                        
                        <!-- Watermark Logo -->
                        <div class="absolute -right-8 -bottom-8 opacity-10 pointer-events-none">
                            <img src="/image/logo_assoc.jpg" class="w-48 h-48 rounded-full">
                        </div>

                        <!-- Card Header -->
                        <div class="flex items-center justify-between border-b border-white/15 pb-4 mb-4">
                            <div class="flex items-center gap-3">
                                <img src="/image/logo_assoc.jpg" class="h-10 w-10 object-contain rounded-xl bg-white p-0.5" alt="Logo">
                                <div>
                                    <h4 class="text-xs font-black tracking-wider text-yellow-300"><%= lang.card_association %></h4>
                                    <p class="text-[10px] text-blue-200">Carte d'Adhérent Officielle</p>
                                </div>
                            </div>
                            <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[10px] font-black px-2 py-0.5 rounded-full">
                                <%= lang.card_status %>
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="flex items-center gap-4 my-5">
                            <div class="w-16 h-16 rounded-2xl bg-white/10 border-2 border-yellow-400/60 flex items-center justify-center text-2xl font-black text-yellow-300 flex-shrink-0">
                                <%= user.nom_complet.charAt(0) %>
                            </div>
                            <div class="overflow-hidden">
                                <h3 class="font-black text-base text-white truncate"><%= user.nom_complet %></h3>
                                <p class="text-xs text-yellow-400 font-mono font-bold"><%= user.membership_id || 'ASLD-2025-00' + user.id %></p>
                                <p class="text-[11px] text-blue-200 truncate">📍 <%= user.quartier || 'مدينة الدروة' %></p>
                            </div>
                        </div>

                        <!-- QR Code & Dues info -->
                        <div class="bg-white/10 backdrop-blur-md p-3.5 rounded-2xl border border-white/10 flex items-center justify-between mt-4">
                            <div class="space-y-1">
                                <p class="text-[10px] text-gray-300"><%= lang.card_dues %></p>
                                <p class="text-xs font-black text-emerald-400"><%= lang.card_dues_paid %></p>
                                <p class="text-[9px] text-gray-400">سارية حتى: دجنبر 2026</p>
                            </div>
                            <!-- Dynamic QR Code representation -->
                            <div class="bg-white p-1.5 rounded-xl flex-shrink-0 shadow-sm">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=60x60&data=ASLD-VERIFIED-<%= user.membership_id || user.id %>" alt="QR" class="w-12 h-12">
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="mt-4 pt-3 border-t border-white/10 flex justify-between items-center text-[9px] text-gray-400">
                            <span>دار الشباب دروة - إقليم برشيد</span>
                            <span class="text-yellow-400 font-bold">2026/2025</span>
                        </div>
                    </div>

                    <div class="bg-blue-50 dark:bg-gray-900 p-5 rounded-2xl border border-blue-100 dark:border-gray-800 text-xs text-gray-600 dark:text-gray-300">
                        💡 <strong>ملاحظة للمنخرط:</strong> بطاقتك الرقمية تخول لك الاستفادة من كافة الورشات المجانية، والمشاركة والتصويت في الجموع العامة وأنشطة دار الشباب.
                    </div>

                </div>
            </div>

            <!-- Right Col: Submissions & Publishing (Members Only) -->
            <div class="lg:col-span-2 space-y-8">
                
                <!-- Publishing Section: Exclusively for Registered Members -->
                <div id="publish-section" class="bg-white dark:bg-gray-900 p-8 md:p-10 rounded-[2.5rem] shadow-xl border border-gray-100 dark:border-gray-800">
                    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <span class="text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">
                                🔒 <%= currentLang === 'en' ? 'Members Exclusive Space' : 'فضاء حصري للمنخرطين' %>
                            </span>
                            <h2 class="text-2xl font-black text-blue-950 dark:text-white mt-1">
                                <%= currentLang === 'en' ? 'Publish Articles & Propose Activities' : 'نشر المقالات واقتراح الأنشطة والورشات' %>
                            </h2>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                بصفتك عضواً معتمداً، يمكنك نشر المقالات التوثيقية واقتراح الورشات التكوينية لتنظيمها بدار الشباب دروة.
                            </p>
                        </div>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                            ✓ عضو مصرح له بالنشر
                        </span>
                    </div>

                    <% if (locals.success) { %>
                        <div class="bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 p-4 mb-6 rounded-2xl font-bold text-sm text-center flex items-center justify-center gap-2 shadow-sm">
                            <span class="text-lg">✅</span>
                            <span><%= success %></span>
                        </div>
                    <% } %>

                    <% if (locals.error) { %>
                        <div class="bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300 p-4 mb-6 rounded-2xl font-bold text-sm text-center flex items-center justify-center gap-2 shadow-sm">
                            <span class="text-lg">⚠️</span>
                            <span><%= error %></span>
                        </div>
                    <% } %>

                    <!-- Tab Switcher -->
                    <div class="flex border-b border-gray-100 dark:border-gray-800 mb-6 gap-2">
                        <button type="button" id="tab-btn-article" onclick="switchPublishTab('article')" class="py-3 px-5 font-black text-xs md:text-sm border-b-2 border-[#122a4e] text-[#122a4e] dark:border-yellow-400 dark:text-yellow-400 flex items-center gap-2 transition">
                            <span>✍️</span>
                            <span><%= currentLang === 'en' ? 'Publish Article / Initiative' : 'نشر مقال أو مبادرة' %></span>
                        </button>
                        <button type="button" id="tab-btn-workshop" onclick="switchPublishTab('workshop')" class="py-3 px-5 font-bold text-xs md:text-sm border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-[#122a4e] dark:hover:text-white flex items-center gap-2 transition">
                            <span>📢</span>
                            <span><%= currentLang === 'en' ? 'Propose Workshop / Activity' : 'اقتراح نشاط أو ورشة عمل' %></span>
                        </button>
                    </div>

                    <!-- 1. Form: Publish Article / Initiative -->
                    <div id="publish-article-pane">
                        <form action="/espace_membre/article" method="POST" class="space-y-5">
                            <div>
                                <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                    <%= currentLang === 'en' ? 'Article / Initiative Title' : 'عنوان المقال أو المبادرة المجتمعية' %> *
                                </label>
                                <input type="text" name="titre" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm outline-none focus:ring-2 focus:ring-blue-500" placeholder="مثال: اختتام الدورة التدريبية لشباب دروة في المهارات الرقمية" required>
                            </div>
                            <div>
                                <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                    <%= currentLang === 'en' ? 'Category' : 'المجال والتصنيف' %> *
                                </label>
                                <select name="category" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm outline-none font-bold" required>
                                    <option value="تطوعي وبيئي">🌱 تطوعي وبيئي</option>
                                    <option value="رياضي">⚽ رياضي وإدماجي</option>
                                    <option value="ثقافي وتربوي">🎨 ثقافي وتربوي</option>
                                    <option value="صحي واجتماعي">🤝 صحي واجتماعي</option>
                                    <option value="تنموي واقتصادي">🚀 تنموي وتمكين اقتصادي</option>
                                </select>
                            </div>
                            <div>
                                <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                    <%= currentLang === 'en' ? 'Full Content & Details' : 'نص المقال وتفاصيل المبادرة' %> *
                                </label>
                                <textarea name="contenu" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm h-36 outline-none focus:ring-2 focus:ring-blue-500" placeholder="اكتب تفاصيل المبادرة أو المقال، الأهداف، الفئات المستفيدة، والنتائج الميدانية..." required></textarea>
                            </div>
                            <div>
                                <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                    رابط صورة المقال (أو اترك فارغاً للصورة الافتراضية)
                                </label>
                                <input type="url" name="image_url" placeholder="https://images.unsplash.com/... (اختياري)" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl text-sm outline-none">
                            </div>
                            <button type="submit" class="w-full bg-[#122a4e] hover:bg-blue-900 text-white py-3.5 rounded-xl font-black text-sm shadow transition flex items-center justify-center gap-2">
                                <span>✍️</span>
                                <span><%= currentLang === 'en' ? 'Publish Article (Submit for Review)' : 'نشر المقال (إرسال للمراجعة والاعتماد)' %></span>
                            </button>
                        </form>
                    </div>

                    <!-- 2. Form: Propose Activity / Workshop -->
                    <div id="publish-workshop-pane" class="hidden">
                        <form action="/espace_membre/workshop" method="POST" class="space-y-5">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="md:col-span-2">
                                    <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                        <%= currentLang === 'en' ? 'Workshop / Activity Title' : 'عنوان الورشة أو النشاط المقترح' %> *
                                    </label>
                                    <input type="text" name="title" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm outline-none focus:ring-2 focus:ring-emerald-500" placeholder="مثال: ورشة تدريبية في تقنيات التصوير والمونتاج بالهاتف" required>
                                </div>
                                <div>
                                    <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                        <%= currentLang === 'en' ? 'Category' : 'المجال والتخصص' %> *
                                    </label>
                                    <select name="category" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm outline-none font-bold" required>
                                        <option value="تأهيل وتكوين">💻 تأهيل وتكوين مهني</option>
                                        <option value="تطوعي وبيئي">🌱 تطوعي وبيئي</option>
                                        <option value="فني ومسرحي">🎭 فنون ومسرح وتعبير</option>
                                        <option value="رياضي وإدماجي">⚽ رياضي وبدني</option>
                                        <option value="ريادة الأعمال">🚀 ريادة أعمال ومشاريع</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                        <%= currentLang === 'en' ? 'Proposed Date & Time' : 'تاريخ وموعد النشاط' %> *
                                    </label>
                                    <input type="text" name="date" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm outline-none focus:ring-2 focus:ring-emerald-500" placeholder="مثال: السبت القادم - 15:00 زوالاً" required>
                                </div>
                                <div>
                                    <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                        <%= currentLang === 'en' ? 'Location' : 'مكان تنظيم النشاط' %>
                                    </label>
                                    <input type="text" name="location" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm outline-none focus:ring-2 focus:ring-emerald-500" value="دار الشباب دروة" placeholder="دار الشباب دروة">
                                </div>
                                <div>
                                    <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                        <%= currentLang === 'en' ? 'Max Seats' : 'عدد المستفيدين المقترح' %>
                                    </label>
                                    <input type="number" name="seats_total" value="30" min="5" max="150" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm outline-none focus:ring-2 focus:ring-emerald-500">
                                </div>
                                <div>
                                    <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                        <%= currentLang === 'en' ? 'Coach / Leader Name' : 'المؤطر أو المسؤول عن التأطير' %>
                                    </label>
                                    <input type="text" name="coach" value="<%= user.nom_complet %>" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm outline-none focus:ring-2 focus:ring-emerald-500">
                                </div>
                                <div>
                                    <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                        رابط صورة توضيحية للنشاط
                                    </label>
                                    <input type="url" name="image_url" placeholder="https://images.unsplash.com/... (اختياري)" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm outline-none">
                                </div>
                            </div>
                            <div>
                                <label class="block mb-1.5 font-bold text-xs text-gray-700 dark:text-gray-300">
                                    <%= currentLang === 'en' ? 'Description & Required Materials' : 'أهداف النشاط والمحتوى والمستلزمات المطلوبة' %> *
                                </label>
                                <textarea name="description" class="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3.5 rounded-xl text-sm h-28 outline-none focus:ring-2 focus:ring-emerald-500" placeholder="ما هي المحاور التي ستتناولها الورشة؟ وما هي التجهيزات المطلوبة من دار الشباب؟" required></textarea>
                            </div>
                            <button type="submit" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white py-3.5 rounded-xl font-black text-sm shadow transition flex items-center justify-center gap-2">
                                <span>📢</span>
                                <span><%= currentLang === 'en' ? 'Propose Workshop to Administration' : 'إرسال مقترح الورشة لإدارة الجمعية والشباب 🚀' %></span>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- User Submissions: Articles & Initiatives -->
                <div class="bg-white dark:bg-gray-900 p-8 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-gray-800">
                    <h3 class="text-lg font-black text-blue-950 dark:text-white mb-4 flex items-center justify-between">
                        <span>✍️ <%= currentLang === 'en' ? 'My Published & Submitted Articles' : 'مقالاتي ومبادراتي المنشورة والمرسلة' %></span>
                        <span class="text-xs text-gray-400 font-normal">(خاص بالأعضاء)</span>
                    </h3>
                    <div class="space-y-3">
                        <% const myArticles = articles.filter(a => a.auteur_id === user.id); %>
                        <% if (myArticles.length === 0) { %>
                            <p class="text-gray-400 text-xs py-4 text-center"><%= currentLang === 'en' ? 'You have not submitted any articles yet.' : 'لم تقم بنشر أي مقالات بعد. استعمل التبويب أعلاه لنشر أول مقال!' %></p>
                        <% } else { %>
                            <% myArticles.forEach(function(item) { %>
                                <div class="flex justify-between items-center bg-gray-50 dark:bg-gray-800/60 p-4 rounded-2xl border border-gray-100 dark:border-gray-700">
                                    <div>
                                        <h4 class="font-bold text-sm text-gray-800 dark:text-white"><%= item.titre %></h4>
                                        <div class="flex items-center gap-2 text-xs text-gray-400 mt-1">
                                            <span>📅 <%= item.date_publication %></span>
                                            <span>•</span>
                                            <span>🏷️ <%= item.category %></span>
                                        </div>
                                    </div>
                                    <div>
                                        <% if (item.status === 'publie') { %>
                                            <span class="bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 px-3 py-1 rounded-lg text-xs font-black">✓ منشور بالبوابة</span>
                                        <% } else { %>
                                            <span class="bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300 px-3 py-1 rounded-lg text-xs font-black">⏳ قيد مراجعة الإدارة</span>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                </div>

                <!-- User Submissions: Proposed Workshops & Activities -->
                <div class="bg-white dark:bg-gray-900 p-8 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-gray-800">
                    <h3 class="text-lg font-black text-blue-950 dark:text-white mb-4 flex items-center justify-between">
                        <span>📢 <%= currentLang === 'en' ? 'My Proposed Workshops & Activities' : 'أنشطتي ووراشتي المقترحة لدار الشباب' %></span>
                        <span class="text-xs text-gray-400 font-normal">(خاص بالأعضاء)</span>
                    </h3>
                    <div class="space-y-3">
                        <% if ((locals.my_workshops || []).length === 0) { %>
                            <p class="text-gray-400 text-xs py-4 text-center"><%= currentLang === 'en' ? 'You have not proposed any workshops yet.' : 'لم تقترح أي ورشات تكوينية بعد. شارك خبرتك واقترح ورشة من النموذج أعلاه!' %></p>
                        <% } else { %>
                            <% my_workshops.forEach(function(ws) { %>
                                <div class="flex justify-between items-center bg-gray-50 dark:bg-gray-800/60 p-4 rounded-2xl border border-gray-100 dark:border-gray-700">
                                    <div>
                                        <h4 class="font-bold text-sm text-gray-800 dark:text-white"><%= ws.title %></h4>
                                        <div class="flex items-center gap-2 text-xs text-gray-400 mt-1">
                                            <span>📅 <%= ws.date %></span>
                                            <span>•</span>
                                            <span>📍 <%= ws.location %></span>
                                            <span>•</span>
                                            <span>🏷️ <%= ws.category %></span>
                                        </div>
                                    </div>
                                    <div>
                                        <% if (ws.status === 'publie') { %>
                                            <span class="bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 px-3 py-1 rounded-lg text-xs font-black">✓ معتمد ومنشور بدار الشباب</span>
                                        <% } else { %>
                                            <span class="bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300 px-3 py-1 rounded-lg text-xs font-black">⏳ قيد مراجعة الإدارة</span>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                </div>

                <!-- User Registered Workshops -->
                <div class="bg-white dark:bg-gray-900 p-8 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-gray-800">
                    <h3 class="text-lg font-black text-blue-950 dark:text-white mb-2 flex items-center justify-between">
                        <span>🎓 <%= currentLang === 'en' ? 'My Workshop Registrations' : 'ورشاتي التكوينية المحجوزة' %></span>
                        <a href="/index.php#workshops" class="text-xs text-blue-600 font-bold hover:underline">استكشاف الورشات +</a>
                    </h3>
                    <div class="space-y-3 mt-4">
                        <% if ((locals.registered_workshops || []).length === 0) { %>
                            <p class="text-gray-400 text-xs py-4 text-center">لم تسجل في أي ورشة بعد. تفقد ورشات دار الشباب القادمة وسجل مجاناً!</p>
                        <% } else { %>
                            <% registered_workshops.forEach(function(rw) { %>
                                <div class="flex justify-between items-center bg-blue-50/60 dark:bg-gray-800/60 p-4 rounded-2xl border border-blue-100 dark:border-gray-700">
                                    <div>
                                        <h4 class="font-bold text-sm text-blue-950 dark:text-white"><%= rw.workshop_title %></h4>
                                        <span class="text-[11px] text-gray-500">تم الحجز في: <%= rw.created_at %></span>
                                    </div>
                                    <span class="bg-emerald-100 text-emerald-800 px-3 py-1 rounded-xl text-xs font-bold">
                                        مقعد مؤكد ✓
                                    </span>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                </div>

                <!-- User Proposals -->
                <div class="bg-white dark:bg-gray-900 p-8 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-gray-800">
                    <h3 class="text-lg font-black text-blue-950 dark:text-white mb-2 flex items-center justify-between">
                        <span>💡 <%= currentLang === 'en' ? 'My Community Proposals' : 'مقترحاتي المطروحة للتصويت' %></span>
                        <a href="/index.php#proposals" class="text-xs text-blue-600 font-bold hover:underline">صوت للمشاريع +</a>
                    </h3>
                    <div class="space-y-3 mt-4">
                        <% if ((locals.my_proposals || []).length === 0) { %>
                            <p class="text-gray-400 text-xs py-4 text-center">لم تطرح أي فكرة للتصويت المجتمعي بعد. شارك فكرتك لتطوير مدينة الدروة!</p>
                        <% } else { %>
                            <% my_proposals.forEach(function(prop) { %>
                                <div class="flex justify-between items-center bg-amber-50/50 dark:bg-gray-800/60 p-4 rounded-2xl border border-amber-100 dark:border-gray-700">
                                    <div>
                                        <h4 class="font-bold text-sm text-gray-900 dark:text-white"><%= prop.title %></h4>
                                        <span class="text-[11px] text-gray-500">المجال: <%= prop.category %></span>
                                    </div>
                                    <span class="bg-amber-100 text-amber-900 font-black px-3 py-1 rounded-xl text-xs">
                                        ⭐ <%= prop.votes %> صوت
                                    </span>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>

    </div>
    <% } %>

    <%- include('partials/footer') %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init({ duration: 800, once: true });</script>
</body>
</html>
