                <button type="button" onclick="filterGallery('sports')" class="gallery-btn bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 px-5 py-2 rounded-xl text-xs font-bold transition" data-filter="sports"><%= lang.gallery_sports %></button>
                <button type="button" onclick="filterGallery('video')" class="gallery-btn bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 px-5 py-2 rounded-xl text-xs font-bold transition" data-filter="video">🎬 <%= lang.gallery_videos %></button>
            </div>

            <!-- Gallery Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="gallery-container">
                <% gallery.forEach(function(item) { %>
                    <div class="gallery-item rounded-3xl overflow-hidden shadow-lg group relative bg-gray-900 border border-gray-100 dark:border-gray-800 cursor-pointer" 
                         data-category="<%= item.category %>" 
                         data-is-video="<%= item.isVideo ? 'true' : 'false' %>"
                         data-image="<%= item.image %>"
                         data-title="<%= item.title %>"
                         data-location="<%= item.location %>"
                         data-video-url="<%= item.videoUrl || '' %>"
                         onclick="handleGalleryClick(this)"
                         data-aos="zoom-in">
                        
                        <img src="<%= item.image %>" class="w-full h-64 object-cover group-hover:scale-105 transition duration-500 opacity-90 group-hover:opacity-100" alt="<%= item.title %>">
                        
                        <% if (item.isVideo) { %>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="w-16 h-16 rounded-full bg-red-600/90 text-white flex items-center justify-center text-2xl shadow-2xl group-hover:scale-110 transition border-2 border-white/80">
                                    ▶
                                </div>
                            </div>
                        <% } else { %>
                            <div class="absolute top-4 <%= currentLang === 'ar' ? 'left-4' : 'right-4' %> opacity-0 group-hover:opacity-100 transition-opacity bg-black/50 text-white p-2 rounded-xl text-sm backdrop-blur-sm">
                                🔍 <%= currentLang === 'en' ? 'Enlarge' : 'تكبير' %>
