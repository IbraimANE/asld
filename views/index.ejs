                            <img src="/image/logo_assoc.jpg" alt="جمعية مبادرات بلا حدود" class="max-h-40 md:max-h-48 w-auto object-contain rounded-xl">
                        </div>
                        
                        <h2 class="text-xl font-black text-[#0e244d] dark:text-white mb-1">
                            <%= lang.hero_title_2 %>
                        </h2>
                        <p class="text-xs font-bold text-amber-600 dark:text-amber-400 mb-6">الجمعية المدنية للتنمية والتضامن - الدروة</p>

                        <!-- Highlights List -->
                        <div class="w-full space-y-2.5 text-right text-xs font-bold text-slate-600 dark:text-slate-300">
                            <div class="flex items-center gap-2.5 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                                <span class="text-base">🏛️</span>
                                <span>المقر الرسمي: دار الشباب الدروة</span>
                            </div>
                            <div class="flex items-center gap-2.5 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                                <span class="text-base">🎓</span>
                                <span>ورشات تكوينية وتأهيلية دورية للشباب</span>
                            </div>
                            <div class="flex items-center gap-2.5 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                                <span class="text-base">🤝</span>
                                <span>ديمقراطية تشاركية ومقترحات مجتمعية</span>
                            </div>
                        </div>

                        <!-- Status Indicator -->
                        <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 w-full flex items-center justify-between text-[11px] font-bold">
                            <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span>الأبواب مفتوحة للانخراط والتطوع</span>
                            </span>
                            <a href="/inscription.php" class="text-blue-700 dark:text-amber-400 hover:underline">انضم إلينا ←</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </header>

    <!-- 1. Executive Impact Metrics (إحصائيات الأثر المجتمعي) -->
    <section class="py-10 bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 text-center" data-aos="fade-up">
                <!-- Beneficiaries -->
                <div class="clean-card p-6 flex flex-col items-center justify-center">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-400 flex items-center justify-center text-xl mb-3">
                        👥
                    </div>
                    <p class="text-3xl md:text-4xl font-black text-[#0e244d] dark:text-amber-400 min-h-[44px] flex items-center justify-center tracking-tight">
                        <%= (locals.impact_stats && locals.impact_stats.beneficiaries) ? locals.impact_stats.beneficiaries : '—' %>
                    </p>
                    <p class="text-xs md:text-sm font-bold text-slate-600 dark:text-slate-300 mt-1"><%= lang.impact_beneficiaries %></p>
                </div>
                <!-- Volunteer Hours -->
                <div class="clean-card p-6 flex flex-col items-center justify-center">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl mb-3">
