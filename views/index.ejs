                <button type="button" onclick="filterGallery('env')" class="gallery-btn bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 px-4 py-2 rounded-lg text-xs font-bold transition border border-slate-200 dark:border-slate-700" data-filter="env"><%= lang.gallery_env %></button>
                <button type="button" onclick="filterGallery('training')" class="gallery-btn bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 px-4 py-2 rounded-lg text-xs font-bold transition border border-slate-200 dark:border-slate-700" data-filter="training"><%= lang.gallery_training %></button>
