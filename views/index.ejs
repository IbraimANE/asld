                <button type="button" onclick="filterGallery('video')" class="gallery-btn bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 px-4 py-2 rounded-lg text-xs font-bold transition border border-slate-200 dark:border-slate-700" data-filter="video">🎬 <%= lang.gallery_videos %></button>
