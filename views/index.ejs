                    <%= lang.explore_btn %>
                </a>
                <a href="#donate" class="bg-gradient-to-r from-emerald-500 to-teal-600 text-white px-8 py-4 rounded-2xl font-black text-base hover:from-emerald-400 hover:to-teal-500 transition-all shadow-xl hover:-translate-y-1">
                    ❤️ <%= lang.donate_btn %>
                </a>
                <a href="/inscription.php" class="bg-yellow-400 text-blue-950 px-8 py-4 rounded-2xl font-black text-base hover:bg-yellow-300 transition-all shadow-xl hover:-translate-y-1">
                    <%= lang.join_us %>
                </a>
            </div>

        </div>

        <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none z-0">
            <svg class="relative block w-full h-[120px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".25" fill="currentColor" class="text-slate-50 dark:text-gray-950"></path>
                <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" opacity=".5" fill="currentColor" class="text-slate-50 dark:text-gray-950"></path>
                <path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z" fill="currentColor" class="text-slate-50 dark:text-gray-950"></path>
            </svg>
        </div>
    </header>

    <!-- 1. Live Impact Metrics (إحصائيات الأثر المجتمعي) -->
    <section class="py-12 -mt-24 container mx-auto px-6 relative z-20" data-aos="fade-up">
        <div class="bg-white dark:bg-gray-900 rounded-[2.5rem] shadow-2xl border border-gray-100 dark:border-gray-800 p-8 md:p-10">
            <div class="text-center mb-8">
                <span class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Impact Metrics</span>
                <h2 class="text-2xl md:text-3xl font-black text-blue-950 dark:text-white mt-1"><%= lang.impact_title %></h2>
            </div>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
                <div class="p-4 rounded-2xl bg-blue-50/60 dark:bg-gray-800/60 border border-blue-100 dark:border-gray-700">
                    <p class="text-3xl md:text-5xl font-black text-blue-900 dark:text-yellow-400">+1,850</p>
                    <p class="text-xs md:text-sm font-bold text-gray-600 dark:text-gray-300 mt-2"><%= lang.impact_beneficiaries %></p>
                </div>
                <div class="p-4 rounded-2xl bg-emerald-50/60 dark:bg-gray-800/60 border border-emerald-100 dark:border-gray-700">
                    <p class="text-3xl md:text-5xl font-black text-emerald-600 dark:text-emerald-400">+620</p>
                    <p class="text-xs md:text-sm font-bold text-gray-600 dark:text-gray-300 mt-2"><%= lang.impact_hours %></p>
                </div>
                <div class="p-4 rounded-2xl bg-amber-50/60 dark:bg-gray-800/60 border border-amber-100 dark:border-gray-700">
                    <p class="text-3xl md:text-5xl font-black text-amber-600 dark:text-amber-400">+450</p>
                    <p class="text-xs md:text-sm font-bold text-gray-600 dark:text-gray-300 mt-2"><%= lang.impact_trees %></p>
                </div>
                <div class="p-4 rounded-2xl bg-indigo-50/60 dark:bg-gray-800/60 border border-indigo-100 dark:border-gray-700">
                    <p class="text-3xl md:text-5xl font-black text-indigo-600 dark:text-indigo-400">+24</p>
                    <p class="text-xs md:text-sm font-bold text-gray-600 dark:text-gray-300 mt-2"><%= lang.impact_workshops %></p>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. About & President Preview Cards -->
    <section id="about-section" class="py-16 container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
            <div data-aos="fade-up" class="bg-white dark:bg-gray-900 p-10 rounded-[2.5rem] shadow-xl shadow-blue-900/5 border border-gray-100 dark:border-gray-800 flex flex-col justify-between">
                <div>
                    <h2 class="text-3xl font-black text-blue-900 dark:text-yellow-400 mb-6 pb-2 border-b-2 border-yellow-400 inline-block">
                        <a href="/about_details.php" class="hover:text-blue-700 dark:hover:text-yellow-300 transition-colors"><%= lang.about_title %></a>
                    </h2>
                    <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-8 text-base md:text-lg">
                        <%= lang.about_desc %>
                    </p>
                </div>
                <a href="/about_details.php" class="w-full bg-[#122a4e] text-white py-4 rounded-2xl font-black text-center block hover:bg-blue-900 transition-all shadow-lg"><%= lang.read_more %></a>
            </div>

            <div class="bg-white dark:bg-gray-900 p-10 rounded-[2.5rem] shadow-xl shadow-blue-900/5 border border-gray-100 dark:border-gray-800 flex flex-col justify-between" data-aos="fade-up" data-aos-delay="100">
                <div>
                    <h2 class="text-3xl font-black text-blue-900 dark:text-yellow-400 mb-6 pb-2 border-b-2 border-yellow-400 inline-block">
                        <a href="/president_details.php" class="hover:text-blue-700 dark:hover:text-yellow-300 transition-colors"><%= lang.president_title %></a>
                    </h2>
                    <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-8 text-base md:text-lg">
                        <%= lang.president_desc %>
                    </p>
                </div>
                <a href="/president_details.php" class="w-full bg-[#122a4e] text-white py-4 rounded-2xl font-black text-center block hover:bg-blue-900 transition-all shadow-lg"><%= lang.read_more %></a>
            </div>
        </div>
    </section>

    <!-- 3. Workshops & Training Opportunities (الورشات والتكوينات والتطوع) -->
    <section id="workshops" class="py-16 bg-blue-50/50 dark:bg-gray-900/40 border-y border-gray-200/60 dark:border-gray-800 transition-colors">
        <div class="container mx-auto px-6">
            <div class="mb-14 text-center" data-aos="fade-up">
                <span class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Free Training Programs</span>
                <h2 class="text-3xl md:text-4xl font-black text-blue-950 dark:text-white mt-1"><%= lang.workshops_title %></h2>
                <p class="text-gray-500 dark:text-gray-400 text-base max-w-xl mx-auto mt-2"><%= lang.workshops_subtitle %></p>
                <div class="h-1.5 w-24 bg-gradient-to-r from-blue-600 to-yellow-400 mx-auto rounded-full mt-4"></div>
                
                <!-- Members Only Workshop Proposal CTA -->
                <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-blue-100 dark:bg-blue-950 text-blue-900 dark:text-blue-200 border border-blue-200 dark:border-blue-800">
                        🔒 <%= currentLang === 'en' ? 'Members Only' : 'مخصص للمنخرطين' %>
                    </span>
                    <a href="<%= locals.user ? '/espace_membre.php#publish-workshop' : '/login.php?msg=members_only' %>" class="inline-flex items-center gap-2 bg-blue-900 hover:bg-blue-950 text-white text-xs sm:text-sm font-black px-5 py-2.5 rounded-xl shadow-md transition hover:-translate-y-0.5">
                        <span>📢</span>
                        <span><%= currentLang === 'en' ? 'Propose an Activity / Workshop' : 'اقتراح أو نشر نشاط / ورشة (خاص بالأعضاء 👤)' %></span>
                    </a>
                </div>
            </div>

            <% if ((workshops || []).length === 0) { %>
                <div class="bg-white dark:bg-gray-900 rounded-[2.5rem] p-12 text-center border border-gray-100 dark:border-gray-800 max-w-xl mx-auto shadow-sm" data-aos="fade-up">
                    <div class="w-16 h-16 bg-blue-50 dark:bg-gray-800 text-blue-900 dark:text-yellow-400 rounded-2xl flex items-center justify-center mx-auto mb-4 text-3xl">
                        🎓
                    </div>
                    <h3 class="text-xl font-black text-blue-950 dark:text-white mb-2">
                        <%= currentLang === 'en' ? 'No Workshops Scheduled Currently' : 'لا توجد ورشات مبرمجة حالياً' %>
                    </h3>
                    <p class="text-gray-500 dark:text-gray-400 text-xs md:text-sm leading-relaxed max-w-md mx-auto">
                        <%= currentLang === 'en' 
                            ? 'Upcoming capacity building workshops and training opportunities at Deroua Youth Center will be published here soon.' 
                            : 'سيتم الإعلان عن جدول الدورات التكوينية والورشات التأهيلية القادمة بدار الشباب دروة قريباً.' %>
                    </p>
                </div>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <% workshops.forEach(function(ws) { %>
                        <div class="bg-white dark:bg-gray-900 rounded-[2rem] overflow-hidden shadow-xl border border-gray-100 dark:border-gray-800 flex flex-col hover:-translate-y-1 transition-all" data-aos="fade-up">
                            <div class="relative h-48 overflow-hidden bg-gray-100">
                                <img src="<%= ws.image %>" class="w-full h-full object-cover" alt="<%= ws.title %>">
                                <span class="absolute top-4 <%= currentLang === 'ar' ? 'right-4' : 'left-4' %> bg-blue-950/90 text-white text-xs font-bold px-3 py-1.5 rounded-xl backdrop-blur-sm">
                                    <%= ws.category %>
                                </span>
                            </div>
                            <div class="p-6 flex-grow flex flex-col">
                                <h3 class="text-xl font-black text-blue-950 dark:text-white mb-2 leading-snug"><%= ws.title %></h3>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mb-4 leading-relaxed"><%= ws.description %></p>
                                
                                <div class="text-xs font-bold text-gray-600 dark:text-gray-300 space-y-1.5 mb-6">
                                    <p class="flex items-center gap-2">📅 <span><%= ws.date %></span></p>
                                    <p class="flex items-center gap-2">📍 <span><%= ws.location %></span></p>
                                    <p class="flex items-center gap-2">👤 <span><%= ws.coach %></span></p>
                                </div>

                                <!-- Seats progress -->
                                <div class="mt-auto mb-6">
                                    <div class="flex justify-between text-xs font-black mb-1">
                                        <span class="text-emerald-600 dark:text-emerald-400"><%= (ws.seats_total - ws.seats_taken) %> <%= lang.workshop_seats_left %></span>
                                        <span class="text-gray-400"><%= ws.seats_taken %> / <%= ws.seats_total %></span>
                                    </div>
                                    <div class="w-full bg-gray-100 dark:bg-gray-800 h-2.5 rounded-full overflow-hidden">
                                        <div class="bg-emerald-500 h-full rounded-full" style="width: <%= Math.round((ws.seats_taken / ws.seats_total) * 100) %>%;"></div>
                                    </div>
                                </div>

                                <button type="button" onclick="openWorkshopModal('<%= ws.id %>', '<%= ws.title %>')" class="w-full bg-[#122a4e] text-white py-3 rounded-xl font-black text-sm hover:bg-blue-900 transition shadow-md">
                                    ✍️ <%= lang.workshop_register %>
                                </button>
                                <div class="mt-2.5 flex items-center justify-center gap-3 text-xs">
                                    <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(ws.title + ' - سجل الآن في ورشات جمعية مبادرات بلا حدود بالدروة') %>" target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 hover:underline font-bold flex items-center gap-1">
                                        <span>💬</span> <span><%= lang.share_whatsapp %></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </section>

    <!-- 4. Participatory Proposals & Member Voting (المبادرات التشاركية والتصويت) -->
    <section id="proposals" class="py-16 container mx-auto px-6">
        <div class="mb-14 text-center" data-aos="fade-up">
            <span class="text-xs font-black uppercase tracking-widest text-blue-600 dark:text-blue-400">Participatory Democracy</span>
            <h2 class="text-3xl md:text-4xl font-black text-blue-950 dark:text-white mt-1"><%= lang.proposals_title %></h2>
            <p class="text-gray-500 dark:text-gray-400 text-base max-w-xl mx-auto mt-2"><%= lang.proposals_subtitle %></p>
            <div class="h-1.5 w-24 bg-gradient-to-r from-blue-600 to-yellow-400 mx-auto rounded-full mt-4"></div>
        </div>

        <% if ((proposals || []).length === 0) { %>
            <div class="bg-white dark:bg-gray-900 rounded-[2.5rem] p-12 text-center border border-gray-100 dark:border-gray-800 max-w-xl mx-auto shadow-sm" data-aos="fade-up">
                <div class="w-16 h-16 bg-amber-50 dark:bg-gray-800 text-amber-500 rounded-2xl flex items-center justify-center mx-auto mb-4 text-3xl">
                    💡
                </div>
                <h3 class="text-xl font-black text-blue-950 dark:text-white mb-2">
                    <%= currentLang === 'en' ? 'No Community Proposals Open for Voting' : 'لا توجد مقترحات تصويت حالياً' %>
                </h3>
                <p class="text-gray-500 dark:text-gray-400 text-xs md:text-sm leading-relaxed max-w-md mx-auto mb-6">
                    <%= currentLang === 'en' 
                        ? 'Be the first to submit a community initiative for Deroua and gather support from residents!' 
                        : 'كن أول من يطرح فكرة أو مبادرة مجتمعية هادفة لمدينة الدروة واجمع أصوات وتأييد الساكنة والشباب.' %>
                </p>
                <button type="button" onclick="openProposalModal()" class="bg-[#122a4e] text-white px-8 py-3.5 rounded-2xl font-black text-xs hover:bg-blue-900 transition shadow-lg">
                    💡 <%= lang.submit_idea %>
                </button>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <% proposals.forEach(function(prop) { %>
                    <div class="bg-white dark:bg-gray-900 p-8 rounded-[2rem] shadow-xl border border-gray-100 dark:border-gray-800 flex flex-col justify-between" data-aos="fade-up">
                        <div>
                            <div class="flex justify-between items-start mb-4">
                                <span class="bg-blue-50 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 text-xs px-3 py-1 rounded-lg font-bold">
                                    <%= prop.category %>
                                </span>
                                <span class="text-xs text-gray-400 font-bold">بواسطة: <%= prop.author %></span>
                            </div>
                            <h3 class="text-xl font-black text-blue-950 dark:text-white mb-3"><%= prop.title %></h3>
                            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
                                <%= prop.description %>
                            </p>
                        </div>

                        <div class="pt-6 border-t border-gray-100 dark:border-gray-800 flex justify-between items-center">
                            <span class="text-lg font-black text-blue-900 dark:text-yellow-400 flex items-center gap-1.5">
                                <span id="vote-count-<%= prop.id %>"><%= prop.votes %></span>
                                <span class="text-xs text-gray-400 font-normal">صوت</span>
                            </span>
                            <div class="flex items-center gap-2">
                                <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent('صوّت على مبادرة: ' + prop.title + ' بجمعية مبادرات بلا حدود') %>" target="_blank" rel="noopener noreferrer" title="<%= lang.share_whatsapp %>" class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 flex items-center justify-center hover:bg-emerald-100 transition">
                                    💬
                                </a>
                                <button type="button" onclick="castVote(<%= prop.id %>)" id="vote-btn-<%= prop.id %>" class="bg-gradient-to-r from-yellow-400 to-amber-500 text-blue-950 px-4 py-2 rounded-xl text-xs font-black shadow hover:shadow-md transition">
                                    👍 <%= lang.vote_btn %>
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>

            <div class="mt-12 text-center" data-aos="fade-up">
                <button type="button" onclick="openProposalModal()" class="bg-[#122a4e] text-white px-8 py-4 rounded-2xl font-black text-base hover:bg-blue-900 transition shadow-xl">
                    💡 <%= lang.submit_idea %>
                </button>
            </div>
        <% } %>
    </section>

    <!-- 5. Latest Activities & Initiatives (Empty by User Request) -->
    <main id="activities" class="py-16 bg-gray-50/70 dark:bg-gray-900/50 border-y border-gray-200/60 dark:border-gray-800 transition-colors">
        <div class="container mx-auto px-6">
            <div class="mb-14 text-center" data-aos="fade-up">
                <span class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Official Portal</span>
                <h2 class="text-3xl md:text-5xl font-black text-blue-950 dark:text-white mb-4"><%= lang.activities_title %></h2>
                <div class="h-1.5 w-32 bg-gradient-to-r from-blue-600 to-yellow-400 mx-auto rounded-full"></div>

                <!-- Members Only Article Publishing CTA -->
                <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-900 dark:text-emerald-200 border border-emerald-200 dark:border-emerald-800">
                        🔒 <%= currentLang === 'en' ? 'Members Only' : 'مخصص للمنخرطين' %>
                    </span>
                    <a href="<%= locals.user ? '/espace_membre.php#publish-article' : '/login.php?msg=members_only' %>" class="inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white text-xs sm:text-sm font-black px-5 py-2.5 rounded-xl shadow-md transition hover:-translate-y-0.5">
                        <span>✍️</span>
                        <span><%= currentLang === 'en' ? 'Publish Article / Initiative' : 'نشر مقال أو مبادرة (خاص بالأعضاء 👤)' %></span>
                    </a>
                </div>
            </div>

            <% if (articles.length === 0) { %>
                <div class="bg-white dark:bg-gray-900 p-12 md:p-16 rounded-[2.5rem] shadow-xl shadow-blue-900/5 border border-gray-100 dark:border-gray-800 max-w-2xl mx-auto text-center" data-aos="fade-up">
                    <div class="w-20 h-20 bg-blue-50 dark:bg-gray-800 text-blue-900 dark:text-yellow-400 rounded-3xl flex items-center justify-center mx-auto mb-6 text-3xl shadow-inner border border-blue-100 dark:border-gray-700">
