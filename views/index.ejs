    <%- include('partials/footer') %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 800, once: true });

        // Gallery Interactivity
        function handleGalleryClick(el) {
            const isVideo = el.dataset.isVideo === 'true';
            if (isVideo) {
                const title = el.dataset.title;
                const url = el.dataset.videoUrl || 'https://www.youtube.com/embed/dQw4w9WgXcQ';
                openVideoModal(title, url);
            } else {
                const src = el.dataset.image;
                const title = el.dataset.title;
                const loc = el.dataset.location;
                openLightbox(src, title, loc);
            }
        }

        function openLightbox(src, title, loc) {
            document.getElementById('lightbox-img').src = src;
            document.getElementById('lightbox-title').textContent = title;
            document.getElementById('lightbox-loc').textContent = '📍 ' + loc;
            const modal = document.getElementById('lightbox-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeLightbox() {
            const modal = document.getElementById('lightbox-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function openVideoModal(title, url) {
            document.getElementById('video-title').textContent = title;
            document.getElementById('video-frame').src = url;
            const modal = document.getElementById('video-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeVideoModal() {
            const modal = document.getElementById('video-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.getElementById('video-frame').src = '';
        }

        // Workshop Modal
        function openWorkshopModal(id, title) {
            document.getElementById('modal-ws-id').value = id;
            document.getElementById('modal-ws-title').textContent = title;
            const modal = document.getElementById('workshop-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
        function closeWorkshopModal() {
            const modal = document.getElementById('workshop-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // Proposal Modal
        function openProposalModal() {
            const modal = document.getElementById('proposal-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
        function closeProposalModal() {
            const modal = document.getElementById('proposal-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // Voting Handler
        function castVote(proposalId) {
            fetch('/proposals/' + proposalId + '/vote', { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.votes !== undefined) {
                        document.getElementById('vote-count-' + proposalId).textContent = data.votes;
                        const btn = document.getElementById('vote-btn-' + proposalId);
                        btn.textContent = 'تم التصويت 👍';
                        btn.classList.remove('from-yellow-400', 'to-amber-500');
                        btn.classList.add('bg-emerald-600', 'text-white');
                        btn.disabled = true;
                    }
                })
                .catch(err => console.error(err));
        }

        // Gallery Filter
        function filterGallery(category) {
            const items = document.querySelectorAll('.gallery-item');
            const btns = document.querySelectorAll('.gallery-btn');
            
            btns.forEach(b => {
                if (b.dataset.filter === category) {
                    b.classList.add('bg-blue-950', 'text-white');
                    b.classList.remove('bg-white', 'text-gray-700');
                } else {
                    b.classList.remove('bg-blue-950', 'text-white');
                    b.classList.add('bg-white', 'text-gray-700');
                }
            });

            items.forEach(item => {
                if (category === 'all' || item.dataset.category === category) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>
