                <button type="button" onclick="filterGallery('env')" class="gallery-btn bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 px-5 py-2 rounded-xl text-xs font-bold transition" data-filter="env"><%= lang.gallery_env %></button>
