                                <% } %>
                            </span>
                            <h4 class="text-white text-sm font-bold leading-snug"><%= item.title %></h4>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <!-- Clean Empty Gallery Placeholder -->
            <div class="max-w-xl mx-auto clean-card p-10 text-center" data-aos="fade-up">
                <div class="w-14 h-14 rounded-2xl bg-amber-50 dark:bg-slate-800 text-amber-600 flex items-center justify-center text-2xl mx-auto mb-3">
