                    </div>
                    <p class="text-3xl md:text-4xl font-black text-emerald-600 dark:text-emerald-400 min-h-[44px] flex items-center justify-center tracking-tight">
                        <%= (locals.impact_stats && locals.impact_stats.volunteer_hours) ? locals.impact_stats.volunteer_hours : '—' %>
                    </p>
                    <p class="text-xs md:text-sm font-bold text-slate-600 dark:text-slate-300 mt-1"><%= lang.impact_hours %></p>
                </div>
                <!-- Planted Trees -->
                <div class="clean-card p-6 flex flex-col items-center justify-center">
                    <div class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl mb-3">
                        🌳
                    </div>
                    <p class="text-3xl md:text-4xl font-black text-amber-600 dark:text-amber-400 min-h-[44px] flex items-center justify-center tracking-tight">
                        <%= (locals.impact_stats && locals.impact_stats.trees_planted) ? locals.impact_stats.trees_planted : '—' %>
                    </p>
                    <p class="text-xs md:text-sm font-bold text-slate-600 dark:text-slate-300 mt-1"><%= lang.impact_trees %></p>
                </div>
                <!-- Training Workshops -->
                <div class="clean-card p-6 flex flex-col items-center justify-center">
                    <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl mb-3">
                        🎓
                    </div>
                    <p class="text-3xl md:text-4xl font-black text-indigo-600 dark:text-indigo-400 min-h-[44px] flex items-center justify-center tracking-tight">
                        <%= (locals.impact_stats && locals.impact_stats.workshops_count) ? locals.impact_stats.workshops_count : '—' %>
                    </p>
                    <p class="text-xs md:text-sm font-bold text-slate-600 dark:text-slate-300 mt-1"><%= lang.impact_workshops %></p>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. About & President Preview Cards -->
    <section id="about-section" class="py-16 container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Card 1: About the Association -->
            <div data-aos="fade-up" class="clean-card p-8 md:p-10 flex flex-col justify-between relative overflow-hidden">
                <div class="absolute top-0 left-0 right-0 h-1 bg-[#0e244d]"></div>
                <div>
                    <div class="flex items-center justify-between mb-5">
                        <span class="section-badge-clean">
                            <span>🏛️</span>
                            <span><%= lang.our_identity %></span>
                        </span>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-black text-[#0e244d] dark:text-white mb-4">
                        <a href="/about_details.php" class="hover:text-blue-700 dark:hover:text-amber-400 transition-colors"><%= lang.about_title %></a>
                    </h2>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-8 text-base font-medium">
                        <%= lang.about_desc %>
                    </p>
                </div>
                <a href="/about_details.php" class="btn-solid-navy w-full py-3 rounded-xl text-center text-sm shadow-sm">
                    <%= lang.read_more %> ←
                </a>
            </div>

            <!-- Card 2: President Word -->
            <div class="clean-card p-8 md:p-10 flex flex-col justify-between relative overflow-hidden" data-aos="fade-up" data-aos-delay="100">
                <div class="absolute top-0 left-0 right-0 h-1 bg-amber-500"></div>
                <div>
                    <div class="flex items-center justify-between mb-5">
                        <span class="section-badge-clean">
                            <span>👤</span>
                            <span><%= lang.president_note %></span>
                        </span>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-black text-[#0e244d] dark:text-white mb-4">
                        <a href="/president_details.php" class="hover:text-blue-700 dark:hover:text-amber-400 transition-colors"><%= lang.president_title %></a>
                    </h2>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-8 text-base font-medium">
                        <%= lang.president_desc %>
                    </p>
                </div>
                <a href="/president_details.php" class="btn-outline-navy w-full py-3 rounded-xl text-center text-sm shadow-sm">
                    <%= lang.read_more %> ←
                </a>
            </div>
        </div>
    </section>

    <!-- 3. Workshops & Training Opportunities (الورشات والتكوينات والتطوع) -->
    <section id="workshops" class="py-16 bg-slate-50/70 dark:bg-slate-900/30 border-y border-slate-200 dark:border-slate-800 transition-colors">
        <div class="container mx-auto px-6">
            <div class="mb-12 text-center" data-aos="fade-up">
                <span class="section-badge-clean">
                    <span>🎓</span>
                    <span>Free Training Programs</span>
                </span>
                <h2 class="text-3xl md:text-4xl font-black text-[#0e244d] dark:text-white mt-3"><%= lang.workshops_title %></h2>
                <p class="text-slate-500 dark:text-slate-400 text-sm md:text-base max-w-xl mx-auto mt-2"><%= lang.workshops_subtitle %></p>
                <div class="clean-divider">
                    <div class="clean-divider-line"></div>
                    <div class="clean-divider-diamond"></div>
                    <div class="clean-divider-line"></div>
                </div>
                
                <!-- Action CTAs for Admin & Members -->
                <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
                    <% if (locals.user && (locals.user.role === 'admin' || locals.user.role === 'president')) { %>
                        <a href="/admin.php#workshops-tab" class="inline-flex items-center gap-2 bg-[#0e244d] hover:bg-slate-800 text-amber-300 text-xs sm:text-sm font-black px-5 py-2.5 rounded-xl shadow-md transition border border-amber-400/30">
                            <span>➕</span>
                            <span>برمجة ونشر ورشة أو تدريب جديد (الإدارة)</span>
                        </a>
                    <% } else { %>
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 dark:bg-slate-800 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-slate-700">
                            🔒 <%= lang.members_only %>
                        </span>
                        <a href="<%= locals.user ? '/espace_membre.php#publish-workshop' : '/login.php?msg=members_only' %>" class="inline-flex items-center gap-2 bg-[#0e244d] hover:bg-slate-800 text-amber-300 text-xs sm:text-sm font-bold px-4 py-2 rounded-lg shadow-sm transition">
                            <span>📢</span>
                            <span><%= lang.propose_workshop_btn %></span>
                        </a>
                    <% } %>
                </div>
            </div>

            <% if ((workshops || []).length === 0) { %>
                <div class="clean-card p-10 text-center max-w-xl mx-auto" data-aos="fade-up">
                    <div class="w-14 h-14 bg-amber-50 dark:bg-slate-800 text-amber-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl">
                        🎓
                    </div>
                    <h3 class="text-lg font-black text-[#0e244d] dark:text-white mb-2">
                        <%= lang.no_workshops %>
                    </h3>
                    <p class="text-slate-500 dark:text-slate-400 text-xs md:text-sm leading-relaxed max-w-md mx-auto mb-6">
                        <%= lang.no_workshops_desc %>
                    </p>
                    <% if (locals.user && (locals.user.role === 'admin' || locals.user.role === 'president')) { %>
                        <a href="/admin.php#workshops-tab" class="btn-solid-navy inline-flex items-center gap-2 px-6 py-3 rounded-xl font-black text-xs text-amber-300 shadow-md hover:scale-105 transition">
                            <span>➕</span>
                            <span>إضافة وبرمجة ورشة أو نشاط تدريبي الآن</span>
                        </a>
                    <% } else if (locals.user) { %>
                        <a href="/espace_membre.php#publish-workshop" class="btn-solid-navy inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-xs text-amber-300 shadow-sm transition">
                            <span>📢</span>
                            <span>اقتراح نشاط أو دورة تدريبية للإدارة</span>
                        </a>
                    <% } else { %>
                        <a href="/login.php" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs text-[#0e244d] dark:text-amber-400 bg-slate-100 dark:bg-slate-800 hover:bg-[#0e244d] hover:text-white transition">
                            <span>🔐</span>
                            <span>تسجيل الدخول (للإدارة والأعضاء) لإضافة ورشة</span>
                        </a>
                    <% } %>
                </div>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <% workshops.forEach(function(ws) { %>
                        <div class="clean-card overflow-hidden flex flex-col" data-aos="fade-up">
                            <% if (ws.image) { %>
                                <div class="relative h-48 overflow-hidden bg-slate-100 dark:bg-slate-800">
                                    <img src="<%= ws.image %>" class="w-full h-full object-cover" alt="<%= ws.title %>">
                                    <span class="absolute top-3 <%= lang.direction === 'rtl' ? 'right-3' : 'left-3' %> bg-[#0e244d]/90 text-amber-300 text-xs font-black px-3 py-1 rounded-lg backdrop-blur-sm shadow border border-amber-400/20">
                                        <%= ws.category %>
                                    </span>
                                </div>
                            <% } else { %>
                                <div class="p-5 pb-0 flex items-center justify-between">
                                    <span class="bg-[#0e244d]/10 dark:bg-slate-800 text-[#0e244d] dark:text-amber-400 text-xs font-black px-3 py-1 rounded-lg border border-[#0e244d]/15 dark:border-slate-700">
                                        <%= ws.category %>
                                    </span>
                                    <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                        <span>مفتوح للتسجيل</span>
                                    </span>
                                </div>
                            <% } %>
                            <div class="p-6 flex-grow flex flex-col">
                                <h3 class="text-lg font-black text-[#0e244d] dark:text-white mb-2 leading-snug"><%= ws.title %></h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 leading-relaxed"><%= ws.description %></p>
                                
                                <div class="text-xs font-bold text-slate-600 dark:text-slate-300 space-y-1.5 mb-6">
                                    <p class="flex items-center gap-2">📅 <span><%= ws.date %></span></p>
                                    <p class="flex items-center gap-2">📍 <span><%= ws.location %></span></p>
                                    <p class="flex items-center gap-2">👤 <span><%= ws.coach %></span></p>
                                </div>

                                <!-- Seats progress -->
                                <div class="mt-auto mb-5">
                                    <div class="flex justify-between text-xs font-bold mb-1">
                                        <span class="text-emerald-600 dark:text-emerald-400"><%= (ws.seats_total - ws.seats_taken) %> <%= lang.workshop_seats_left %></span>
                                        <span class="text-slate-400"><%= ws.seats_taken %> / <%= ws.seats_total %></span>
                                    </div>
                                    <div class="w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden">
                                        <div class="bg-emerald-500 h-full rounded-full" style="width: <%= Math.round((ws.seats_taken / ws.seats_total) * 100) %>%;"></div>
                                    </div>
                                </div>

                                <button type="button" onclick="openWorkshopModal('<%= ws.id %>', '<%= ws.title %>')" class="btn-solid-navy w-full py-2.5 rounded-xl font-black text-xs text-amber-300 shadow-sm">
                                    ✍️ <%= lang.workshop_register %>
                                </button>
                                <div class="mt-2.5 flex items-center justify-center gap-3 text-xs">
                                    <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(ws.title + ' - سجل الآن في ورشات جمعية مبادرات بلا حدود بالدروة') %>" target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 hover:underline font-bold flex items-center gap-1">
                                        <span>💬</span> <span><%= lang.share_whatsapp %></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </section>

    <!-- 4. Participatory Proposals & Member Voting (المبادرات التشاركية والتصويت) -->
    <section id="proposals" class="py-16 container mx-auto px-6">
        <div class="mb-12 text-center" data-aos="fade-up">
            <span class="section-badge-clean">
                <span>💡</span>
                <span>Participatory Democracy</span>
            </span>
            <h2 class="text-3xl md:text-4xl font-black text-[#0e244d] dark:text-white mt-3"><%= lang.proposals_title %></h2>
            <p class="text-slate-500 dark:text-slate-400 text-sm md:text-base max-w-xl mx-auto mt-2"><%= lang.proposals_subtitle %></p>
            <div class="clean-divider">
                <div class="clean-divider-line"></div>
                <div class="clean-divider-diamond"></div>
                <div class="clean-divider-line"></div>
            </div>
        </div>

        <% if ((proposals || []).length === 0) { %>
            <div class="clean-card p-10 text-center max-w-xl mx-auto" data-aos="fade-up">
                <div class="w-14 h-14 bg-amber-50 dark:bg-slate-800 text-amber-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl">
                    💡
                </div>
                <h3 class="text-lg font-black text-[#0e244d] dark:text-white mb-2">
                    <%= lang.no_proposals %>
                </h3>
                <p class="text-slate-500 dark:text-slate-400 text-xs md:text-sm leading-relaxed max-w-md mx-auto mb-6">
                    <%= lang.no_proposals_desc %>
                </p>
                <button type="button" onclick="openProposalModal()" class="btn-solid-navy px-6 py-3 rounded-xl font-bold text-xs shadow-sm">
                    💡 <%= lang.submit_idea %>
                </button>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <% proposals.forEach(function(prop) { %>
                    <div class="clean-card p-6 flex flex-col justify-between" data-aos="fade-up">
                        <div>
                            <div class="flex justify-between items-start mb-3">
                                <span class="bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs px-2.5 py-1 rounded-lg font-bold">
                                    <%= prop.category %>
                                </span>
                                <span class="text-[11px] text-slate-400 font-medium">بواسطة: <%= prop.author %></span>
