            <button type="button" onclick="closeVideoModal()" class="absolute -top-12 <%= currentLang === 'ar' ? 'left-0' : 'right-0' %> text-white text-3xl font-black hover:text-yellow-400 transition">✕</button>
            <div class="w-full aspect-video rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-black">
                <iframe id="video-frame" class="w-full h-full" src="" title="Video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
            <h4 id="video-title" class="mt-4 text-white text-lg font-bold text-center"></h4>
        </div>
