<!DOCTYPE html>
<html lang="<%= lang.lang_code %>" dir="<%= lang.direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentLang === 'en' ? 'Join Us | Boundless Initiatives' : 'انضم إلينا | مبادرات بلا حدود' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="/custom.css">
    <style>
        body { font-family: 'Tajawal', sans-serif; background: #f8fafc; }
        .hero-pattern { background-color: #122a4e; background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0); background-size: 40px 40px; }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-6 py-20 hero-pattern">
    <div class="max-w-2xl w-full bg-white/95 backdrop-blur-xl p-8 md:p-14 rounded-[3rem] shadow-2xl border border-white/20" data-aos="zoom-in">
        <div class="text-center mb-12">
            <a href="/index.php">
                <img src="/image/logo_assoc.jpg" class="h-20 w-auto mx-auto mb-6 rounded-2xl shadow-sm bg-white p-1 border border-gray-100" alt="Logo">
            </a>
            <h2 class="text-4xl font-black text-[#122a4e] mb-3">
                <%= currentLang === 'en' ? 'New Member Registration' : 'تسجيل عضو جديد' %>
            </h2>
            <p class="text-gray-500 font-medium">
                <%= currentLang === 'en' ? 'Be part of the community development and solidarity journey' : 'كن جزءاً من مسيرة التنمية والابتكار والمواطنة الفاعلة' %>
            </p>
        </div>

        <% if (locals.error) { %>
            <div class="bg-red-50 text-red-600 p-4 rounded-2xl mb-6 text-sm font-bold border border-red-100">
                <%= error %>
            </div>
        <% } %>
        
        <form action="/traitement.php" method="POST" enctype="multipart/form-data" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1 <%= currentLang === 'en' ? 'ml-2' : 'mr-2' %>">
                        <%= currentLang === 'en' ? 'Full Name' : 'الاسم الكامل' %>
                    </label>
                    <input type="text" name="nom" class="w-full bg-gray-50 border border-gray-100 p-4 rounded-2xl outline-none focus:ring-4 focus:ring-blue-500/10 transition" placeholder="<%= currentLang === 'en' ? 'John Doe' : 'الإسم الكامل' %>" required>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1 <%= currentLang === 'en' ? 'ml-2' : 'mr-2' %>">
                        <%= currentLang === 'en' ? 'Phone Number' : 'رقم الهاتف' %>
                    </label>
                    <input type="tel" name="telephone" class="w-full bg-gray-50 border border-gray-100 p-4 rounded-2xl outline-none focus:ring-4 focus:ring-blue-500/10 transition" placeholder="06XXXXXXXX" required>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-500 mb-1 <%= currentLang === 'en' ? 'ml-2' : 'mr-2' %>">
                    <%= currentLang === 'en' ? 'Email Address' : 'البريد الإلكتروني' %>
                </label>
                <input type="email" name="email" class="w-full bg-gray-50 border border-gray-100 p-4 rounded-2xl outline-none focus:ring-4 focus:ring-blue-500/10 transition" placeholder="name@mail.com" required>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-500 mb-1 <%= currentLang === 'en' ? 'ml-2' : 'mr-2' %>">
                    <%= currentLang === 'en' ? 'Password' : 'كلمة المرور' %>
                </label>
                <input type="password" name="password" class="w-full bg-gray-50 border border-gray-100 p-4 rounded-2xl outline-none focus:ring-4 focus:ring-blue-500/10 transition" placeholder="••••••••" required>
            </div>

            <div class="bg-yellow-50 border-r-4 border-yellow-400 p-4 rounded-2xl my-6">
                <p class="text-yellow-800 text-sm font-bold">
                    📢 <%= currentLang === 'en' ? 'Reminder: Annual membership fee is set at 100 MAD.' : 'تذكير: واجب الانخراط السنوي في الجمعية محدد في 100 درهم.' %>
                </p>
            </div>

            <div class="space-y-4 bg-blue-50/50 p-6 rounded-[2rem] border border-blue-100">
                <h3 class="font-black text-blue-900 text-sm mb-4 uppercase tracking-widest">
                    <%= currentLang === 'en' ? 'Upload Required Documents' : 'رفع الوثائق المطلوبة' %>
                </h3>
                <div class="space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-white p-3 px-5 rounded-2xl border border-blue-50">
                        <label class="text-xs font-bold text-gray-500"><%= currentLang === 'en' ? 'Profile Picture' : 'الصورة الشخصية' %></label>
                        <input type="file" name="photo" class="text-xs text-blue-600 file:bg-blue-100 file:text-blue-900 file:border-0 file:rounded-lg file:px-3 file:py-1 cursor-pointer">
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-white p-3 px-5 rounded-2xl border border-blue-50">
                        <label class="text-xs font-bold text-gray-500"><%= currentLang === 'en' ? 'National ID (Front)' : 'البطاقة الوطنية (وجه 1)' %></label>
                        <input type="file" name="cin_recto" class="text-xs text-blue-600 file:bg-blue-100 file:text-blue-900 file:border-0 file:rounded-lg file:px-3 file:py-1 cursor-pointer">
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-white p-3 px-5 rounded-2xl border border-blue-50">
                        <label class="text-xs font-bold text-gray-500"><%= currentLang === 'en' ? 'National ID (Back)' : 'البطاقة الوطنية (وجه 2)' %></label>
                        <input type="file" name="cin_verso" class="text-xs text-blue-600 file:bg-blue-100 file:text-blue-900 file:border-0 file:rounded-lg file:px-3 file:py-1 cursor-pointer">
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-[#122a4e] to-[#2C69B3] text-white py-5 rounded-[2rem] font-black text-xl shadow-2xl shadow-blue-900/30 hover:scale-[1.02] transition-all">
                <%= currentLang === 'en' ? 'Submit Membership Request' : 'إرسال طلب الانخراط' %>
            </button>
            <div class="mt-8 text-center flex justify-between items-center text-sm">
                <a href="/index.php" class="text-blue-600 font-bold hover:underline">← <%= lang.back_home %></a>
                <a href="/login.php" class="text-gray-500 font-medium hover:text-blue-900"><%= currentLang === 'en' ? 'Already a member? Log in' : 'لديك حساب بالفعل؟ سجل دخولك' %></a>
            </div>
        </form>
    </div>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init({ duration: 800, once: true });</script>
</body>
</html>
