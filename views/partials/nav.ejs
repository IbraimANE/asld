        <div class="container mx-auto flex items-center justify-between gap-4">
            <div class="flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap">
                <span><%= lang.urgent_announcement %></span>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0">
                <a href="/index.php#workshops" class="bg-blue-950 text-white px-3 py-1 rounded-lg text-xs hover:bg-blue-900 transition">
                    <%= lang.nav_workshops %>
                </a>
                <button type="button" onclick="document.getElementById('urgent-bar').style.display='none'" class="text-blue-950/70 hover:text-blue-950 font-bold px-1.5 py-0.5" title="Close">✕</button>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Main Navigation -->
