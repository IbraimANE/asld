<!DOCTYPE html>
<html lang="<%= lang.lang_code %>" dir="<%= lang.direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentLang === 'en' ? "President's Message & CV | Boundless Initiatives" : 'كلمة الرئيس والسيرة الذاتية | مبادرات بلا حدود' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="/custom.css">
    <style>
        body { font-family: 'Tajawal', sans-serif; scroll-behavior: smooth; background-color: #f0f4f8; overflow-x: hidden; }
    </style>
</head>
<body class="text-gray-800">

    <%- include('partials/nav') %>

    <main class="py-20 container mx-auto px-6 max-w-4xl">
        <article data-aos="fade-up" class="bg-white p-12 rounded-[2.5rem] shadow-xl shadow-blue-900/5 border border-gray-100">
            
            <div class="flex flex-col md:flex-row items-center md:items-start gap-8 pb-8 border-b border-gray-100">
                <div class="w-48 h-48 rounded-2xl overflow-hidden bg-gray-100 flex-shrink-0 shadow-md border-4 border-white">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&fit=crop&q=80" alt="رئيس الجمعية" class="w-full h-full object-cover">
                </div>
                <div>
                    <h1 class="text-4xl font-black text-blue-900 mb-2">
                        <%= currentLang === 'en' ? "Association President's Address" : 'كلمة رئيس الجمعية' %>
                    </h1>
                    <p class="text-lg font-bold text-gray-500 mb-4">
                        <%= currentLang === 'en' ? 'President / El Khadir El Ghrabi' : 'رئيس الجمعية / الخدير الغرابي' %>
                    </p>
                    <div class="h-1 w-20 bg-gradient-to-r from-blue-600 to-yellow-400 rounded-full"></div>
                </div>
            </div>

            <div class="space-y-8 text-gray-700 text-lg leading-relaxed text-justify mt-8">
                
                <div>
                    <h3 class="text-2xl font-black text-blue-950 mb-3"><%= currentLang === 'en' ? 'Opening Remarks' : 'الكلمة الافتتاحية' %></h3>
                    <p>
                        <%= currentLang === 'en'
                            ? 'The true investment of any thriving society lies in the hands of its active youth and committed community leaders. In Boundless Initiatives, we are dedicated to providing a fertile ground that turns every ambitious idea into tangible local impact, contributing together to social solidarity and responsible citizenship.'
                            : 'إن الاستثمار الحقيقي لأي مجتمع يكمن في سواعد شبابه ونخبته الحية. نلتزم في جمعية مبادرات بلا حدود بتوفير بيئة خصبة تتيح لكل فكرة طموحة أن تتحول إلى أثر ملموس على أرض الواقع، مساهمين معاً في بناء مغرب الغد وتفعيل آليات التضامن والتكافل الاجتماعي والمواطنة الفاعلة.' %>
                    </p>
                </div>

                <div>
                    <h3 class="text-2xl font-black text-blue-950 mb-3"><%= currentLang === 'en' ? 'Curriculum Vitae' : 'السيرة الذاتية لرئيس الجمعية' %></h3>
                    <ul class="space-y-3 <%= currentLang === 'en' ? 'pl-2' : 'pr-2' %>">
                        <li class="flex items-start gap-2">
                            <span class="text-yellow-500 font-black mt-1">▪</span>
                            <div>
                                <strong class="text-blue-900"><%= currentLang === 'en' ? 'Academic Background:' : 'المسار الأكاديمي:' %></strong>
                                <%= currentLang === 'en' ? 'Higher Education in Social Sciences & Local Governance.' : 'دراسات عليا في العلوم الإنسانية وتدبير التنمية المحلية.' %>
                            </div>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-yellow-500 font-black mt-1">▪</span>
                            <div>
                                <strong class="text-blue-900"><%= currentLang === 'en' ? 'Professional Experience:' : 'الخبرة المهنية:' %></strong>
                                <%= currentLang === 'en' ? 'Project management consultant and civic training coordinator.' : 'فاعل ومستشار في إدارة المشاريع التنموية وتنسيق الورشات المجتمعية.' %>
                            </div>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-yellow-500 font-black mt-1">▪</span>
                            <div>
                                <strong class="text-blue-900"><%= currentLang === 'en' ? 'Civic & Volunteer Leadership:' : 'التجربة الجمعوية والمدنية:' %></strong>
                                <%= currentLang === 'en' ? 'Over 12 years of active civic engagement leading youth programs in Berrechid and Casablanca-Settat.' : 'أكثر من 12 سنة من العمل الميداني التطوعي وتأطير مبادرات الشباب والطفولة.' %>
                            </div>
                        </li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-2xl font-black text-blue-950 mb-4"><%= currentLang === 'en' ? 'Field Visual Presentation' : 'العرض المرئي والميداني' %></h3>
                    <div class="w-full aspect-video rounded-3xl bg-gray-900 flex flex-col justify-center items-center p-6 text-center shadow-inner relative overflow-hidden group border border-gray-800">
                        <div class="z-10">
                            <svg class="w-16 h-16 text-yellow-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <p class="text-white font-bold text-base"><%= currentLang === 'en' ? 'Boundless Initiatives - Official Presentation' : 'فيديو تعريفي بأنشطة جمعية مبادرات بلا حدود' %></p>
                            <p class="text-gray-400 text-xs mt-1">Deroua - Berrechid</p>
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-tr from-blue-950/40 to-transparent pointer-events-none"></div>
                    </div>
                </div>

            </div>

            <div class="mt-12 pt-6 border-t border-gray-100 flex justify-end">
                <a href="/index.php" class="bg-blue-900 text-white px-8 py-3 rounded-xl font-bold hover:bg-blue-800 transition-colors shadow-md"><%= lang.back_home %></a>
            </div>
        </article>
    </main>

    <%- include('partials/footer') %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init({duration: 800, once: true});</script>
</body>
</html>
